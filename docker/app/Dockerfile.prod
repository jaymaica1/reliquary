# Build stage
FROM php:8.2-apache AS build

# Add version argument
ARG APP_VERSION=0.0.0-dev

# Install build dependencies (headers, compilers) and runtime libs needed to compile
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        git \
        unzip \
        pkg-config \
        libpq-dev \
        libicu-dev \
        libzip-dev \
        libmagickwand-dev; \
    rm -rf /var/lib/apt/lists/*

# Install PHP core extensions (build)
RUN docker-php-ext-install \
    pdo \
    pdo_pgsql \
    intl \
    zip \
    ctype \
    iconv

# Build and enable PECL extensions (Imagick, MongoDB) in builder
RUN set -eux; \
    pecl install imagick mongodb; \
    docker-php-ext-enable imagick mongodb; \
    rm -rf /tmp/pear

# Enable Apache modules for build tasks (not strictly needed, but harmless)
RUN a2enmod rewrite headers

# Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Set working directory
WORKDIR /var/www

# Copy composer files and install prod deps with optimizations
COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --prefer-dist \
    --no-progress \
    --no-interaction \
    --classmap-authoritative \
    --optimize-autoloader \
    --no-scripts

# Copy application code (only what's needed to build assets)
COPY bin ./bin
COPY config ./config
COPY src ./src
COPY templates ./templates
COPY assets ./assets
COPY public ./public
COPY translations ./translations
COPY importmap.php ./
COPY php.ini ./php.ini
COPY VERSION ./VERSION

# Prepare app cache directories (avoid Symfony complaining during build)
RUN mkdir -p var && chmod -R 777 var

# Build Symfony cache and frontend assets in builder
RUN APP_ENV=prod php bin/console cache:clear --no-warmup
RUN APP_ENV=prod php bin/console cache:warmup
RUN APP_ENV=prod php bin/console importmap:install
RUN APP_ENV=prod php bin/console asset-map:compile

# Production stage (runtime-only)
FROM php:8.2-apache AS production

# Add version argument
ARG APP_VERSION=0.0.0-dev

# Install only runtime libraries; no -dev headers; clean apt in same layer
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        libpq5 \
        libicu72 \
        libzip4 \
        imagemagick \
    ; \
    rm -rf /var/lib/apt/lists/*

# Copy compiled PHP extensions (.so) and ini configurations from builder
# Extensions directory path varies; use the same PHP image so ABI matches
ARG PHP_EXT_DIR=/usr/local/lib/php/extensions
RUN mkdir -p ${PHP_EXT_DIR}
COPY --from=build /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/
COPY --from=build /usr/local/etc/php/conf.d/ /usr/local/etc/php/conf.d/

# Enable Apache modules
RUN a2enmod rewrite ssl headers

# Configure PHP for production
RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && echo "opcache.enable=1" >> "$PHP_INI_DIR/php.ini" \
    && echo "opcache.memory_consumption=256" >> "$PHP_INI_DIR/php.ini" \
    && echo "opcache.max_accelerated_files=20000" >> "$PHP_INI_DIR/php.ini" \
    && echo "opcache.validate_timestamps=0" >> "$PHP_INI_DIR/php.ini" \
    && echo "realpath_cache_size=4096K" >> "$PHP_INI_DIR/php.ini" \
    && echo "realpath_cache_ttl=600" >> "$PHP_INI_DIR/php.ini"

# Create directory for SSL certificates
RUN mkdir -p /etc/apache2/ssl

# Generate self-signed SSL certificate
RUN openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
    -keyout /etc/apache2/ssl/apache.key -out /etc/apache2/ssl/apache.crt \
    -subj "/C=US/ST=State/L=City/O=Organization/CN=localhost"

# Configure Apache virtual hosts
COPY docker/app/apache-prod.conf /etc/apache2/sites-available/000-default.conf
COPY docker/app/apache-ssl.conf /etc/apache2/sites-available/default-ssl.conf

# Enable SSL site
RUN a2ensite default-ssl

# Set working directory
WORKDIR /var/www

# Set version environment variable
ENV APP_VERSION=${APP_VERSION}

# Copy application files
COPY . .

# Copy built vendor and assets from build stage
COPY --from=build /var/www/vendor ./vendor
COPY --from=build /var/www/public/assets ./public/assets
COPY --from=build /var/www/var/asset-map.json ./var/asset-map.json

# Ensure cache is present (already warmed in builder); no need to rebuild

# Set permissions
RUN chown -R www-data:www-data /var/www \
    && chmod -R 755 /var/www

# Expose ports
EXPOSE 80 443

# Copy entrypoint script
COPY docker/app/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Set entrypoint
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
