###> app/access-log ###
# Access Log PII Protection Configuration
# Controls how sensitive data is handled in access logs
# Options: 'none' (development only), 'partial' (default), 'full' (production)
ACCESS_LOG_PII_PROTECTION=partial
###< app/access-log ###
