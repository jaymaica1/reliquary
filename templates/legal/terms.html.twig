{% extends 'landing_base.html.twig' %}

{% block title %}{{ 'terms.title'|trans({}, 'legal') }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/landing.css') }}">
    <style>
        .legal-content {
            color: rgba(254, 254, 254, 0.9);
            line-height: 1.6;
            font-size: 1.1rem;
        }
        .legal-section {
            margin-bottom: 2.5rem;
        }
        .legal-section h3 {
            color: var(--accent-gold);
            font-family: 'Cinzel', serif;
            margin-bottom: 1rem;
        }
        .last-updated {
            font-style: italic;
            color: rgba(254, 254, 254, 0.6);
            margin-bottom: 0.5rem;
        }
        .ai-disclaimer {
            font-size: 0.9rem;
            color: var(--accent-gold);
            opacity: 0.8;
            margin-bottom: 2rem;
            max-width: 800px;
            margin-left: auto;
            margin-right: auto;
        }
        .legal-card {
            background: rgba(254, 254, 254, 0.05);
            border: 1px solid rgba(245, 158, 11, 0.2);
            border-radius: 15px;
            padding: 3rem;
            transition: all 0.3s ease;
            position: relative;
        }
        .legal-card:hover {
            border-color: var(--accent-gold);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }
    </style>
{% endblock %}

{% block body %}
<section class="relic-classes" style="padding-top: 120px; padding-bottom: 80px;">
    <div class="contact-container">
        <h2 class="section-title">{{ 'terms.title'|trans({}, 'legal') }}</h2>
        <p class="last-updated text-center">{{ 'terms.last_updated'|trans({}, 'legal') }}</p>
        <p class="ai-disclaimer text-center">
            <i class="fas fa-robot me-1"></i> {{ 'terms.ai_disclaimer'|trans({}, 'legal') }}
        </p>

        <div class="row mt-5 justify-content-center">
            <div class="col-lg-10">
                <div class="legal-card text-start mb-5">
                    <div class="legal-content">
                        <div class="legal-section">
                            <h3>{{ 'terms.acceptance.title'|trans({}, 'legal') }}</h3>
                            <p>{{ 'terms.acceptance.content'|trans({}, 'legal') }}</p>
                        </div>

                        <div class="legal-section">
                            <h3>{{ 'terms.user_conduct.title'|trans({}, 'legal') }}</h3>
                            <p>{{ 'terms.user_conduct.content'|trans({}, 'legal') }}</p>
                        </div>

                        <div class="legal-section">
                            <h3>{{ 'terms.content_submission.title'|trans({}, 'legal') }}</h3>
                            <p>{{ 'terms.content_submission.content'|trans({}, 'legal') }}</p>
                        </div>

                        <div class="legal-section">
                            <h3>{{ 'terms.intellectual_property.title'|trans({}, 'legal') }}</h3>
                            <p>{{ 'terms.intellectual_property.content'|trans({}, 'legal') }}</p>
                        </div>

                        <div class="legal-section">
                            <h3>{{ 'terms.disclaimer.title'|trans({}, 'legal') }}</h3>
                            <p>{{ 'terms.disclaimer.content'|trans({}, 'legal') }}</p>
                        </div>

                        <div class="legal-section">
                            <h3>{{ 'terms.limitation_liability.title'|trans({}, 'legal') }}</h3>
                            <p>{{ 'terms.limitation_liability.content'|trans({}, 'legal') }}</p>
                        </div>
                    </div>
                </div>
                
                <div class="text-center mt-4">
                    <a href="{{ path('app_landing') }}" class="gold-link">
                        <i class="fas fa-arrow-left me-2"></i>{{ 'common.navigation.main_site'|trans({}, 'common') }}
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
