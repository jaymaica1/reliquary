{% extends 'landing_base.html.twig' %}

{% block title %}{{ 'contact.title'|trans({}, 'landing') }}{% endblock %}

{% block body %}
<section id="contact" class="contact-section">
    <div class="contact-container">
        <h2 class="section-title">{{ 'contact.title'|trans({}, 'landing') }}</h2>
        <p class="section-subtitle">{{ 'contact.subtitle'|trans({}, 'landing') }}</p>

        {% include '_flash_messages.html.twig' %}

        <div class="contact-content">
            <div class="contact-info">
                <h3>{{ 'contact.info.title'|trans({}, 'landing') }}</h3>
                <div class="contact-item">
                    <strong>{{ 'contact.info.email'|trans({}, 'landing') }}</strong>
                    <p>contact@santasreliquias.com.br</p>
                </div>
                <div class="contact-item">
                    <strong>{{ 'contact.info.mission'|trans({}, 'landing') }}</strong>
                    <p>{{ 'contact.info.mission_text'|trans({}, 'landing') }}</p>
                </div>
                <div class="contact-item">
                    <strong>{{ 'contact.info.response'|trans({}, 'landing') }}</strong>
                    <p>{{ 'contact.info.response_text'|trans({}, 'landing') }}</p>
                </div>
                <div class="contact-item">
                    <strong>{{ 'contact.info.technical_issues.title'|trans({}, 'landing') }}</strong>
                    <p>{{ 'contact.info.technical_issues.text'|trans({}, 'landing') }}</p>
                    <p><a href="https://github.com/CesarScur/reliquary" target="_blank" rel="noopener noreferrer" class="github-link">
                        <i class="fab fa-github me-1"></i> {{ 'contact.info.technical_issues.link'|trans({}, 'landing') }}
                    </a></p>
                </div>
            </div>

            <div class="contact-form-section">
                <h3>{{ 'contact.form.title'|trans({}, 'landing') }}</h3>
                {{ form_start(form, {'attr': {'class': 'contact-form'}}) }}
                    <div class="form-group">
                        {{ form_label(form.name) }}
                        {{ form_widget(form.name) }}
                        {{ form_errors(form.name) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.email) }}
                        {{ form_widget(form.email) }}
                        {{ form_errors(form.email) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.subject) }}
                        {{ form_widget(form.subject) }}
                        {{ form_errors(form.subject) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.message) }}
                        {{ form_widget(form.message) }}
                        {{ form_errors(form.message) }}
                    </div>
                    <button type="submit" class="btn btn-primary">{{ 'contact.form.send'|trans({}, 'landing') }}</button>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</section>
{% endblock %}