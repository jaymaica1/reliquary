{% extends 'landing_base.html.twig' %}

{% block title %}{{ 'contact.title'|trans({}, 'landing') }}{% endblock %}

{% block body %}
<section id="contact" class="contact-section">
    <div class="contact-container">
        <h2 class="section-title">{{ 'contact.title'|trans({}, 'landing') }}</h2>
        <p class="section-subtitle">{{ 'contact.subtitle'|trans({}, 'landing') }}</p>
        
        <div class="contact-content">
            <div class="contact-info">
                <h3>{{ 'contact.info.title'|trans({}, 'landing') }}</h3>
                <div class="contact-item">
                    <strong>{{ 'contact.info.email'|trans({}, 'landing') }}</strong>
                    <p>contact@reliquary.org</p>
                </div>
                <div class="contact-item">
                    <strong>{{ 'contact.info.mission'|trans({}, 'landing') }}</strong>
                    <p>{{ 'contact.info.mission_text'|trans({}, 'landing') }}</p>
                </div>
                <div class="contact-item">
                    <strong>{{ 'contact.info.response'|trans({}, 'landing') }}</strong>
                    <p>{{ 'contact.info.response_text'|trans({}, 'landing') }}</p>
                </div>
            </div>
            
            <div class="contact-form-section">
                <h3>{{ 'contact.form.title'|trans({}, 'landing') }}</h3>
                <form class="contact-form" action="{{ path('app_contact') }}" method="post">
                    <div class="form-group">
                        <label for="name">{{ 'contact.form.name'|trans({}, 'landing') }}</label>
                        <input type="text" id="name" name="name" required>
                    </div>
                    <div class="form-group">
                        <label for="email">{{ 'contact.form.email'|trans({}, 'landing') }}</label>
                        <input type="email" id="email" name="email" required>
                    </div>
                    <div class="form-group">
                        <label for="subject">{{ 'contact.form.subject'|trans({}, 'landing') }}</label>
                        <select id="subject" name="subject" required>
                            <option value="">{{ 'contact.form.select_subject'|trans({}, 'landing') }}</option>
                            <option value="relic_submission">{{ 'contact.form.subjects.relic_submission'|trans({}, 'landing') }}</option>
                            <option value="authentication">{{ 'contact.form.subjects.authentication'|trans({}, 'landing') }}</option>
                            <option value="general_inquiry">{{ 'contact.form.subjects.general_inquiry'|trans({}, 'landing') }}</option>
                            <option value="technical_support">{{ 'contact.form.subjects.technical_support'|trans({}, 'landing') }}</option>
                            <option value="partnership">{{ 'contact.form.subjects.partnership'|trans({}, 'landing') }}</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="message">{{ 'contact.form.message'|trans({}, 'landing') }}</label>
                        <textarea id="message" name="message" rows="6" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">{{ 'contact.form.send'|trans({}, 'landing') }}</button>
                </form>
            </div>
        </div>
    </div>
</section>
{% endblock %}