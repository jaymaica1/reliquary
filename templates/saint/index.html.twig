{% extends 'landing_base.html.twig' %}

{% block title %}{{ title ?? 'saint.title'|trans({}, 'saint') }}{% endblock %}

{% block body %}
    <section class="list">
        <h2 class="section-title">{{ title ?? 'saint.title'|trans({}, 'saint') }}</h2>
        <p class="section-subtitle">{{ 'saint.subtitle'|trans({'default': 'Discover the lives of saints and their sacred legacy'}, 'saint') }}</p>

        <div class="filter-section" data-controller="filter-toggle">
            <div class="filter-header">
                <div class="filter-header-content">
                    {% if app.request.get('_route') == 'app_saint_index' %}
                    <button type="button" class="btn btn-secondary" data-action="filter-toggle#toggle">
                        <i class="fas fa-eye" data-filter-toggle-target="icon"></i>
                        {{ 'saint.filter.filter'|trans({'default': 'Filter'}, 'saint') }}
                    </button>
                    {% endif %}
                    {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_saint_new') }}" class="btn btn-primary">
                        <i class="fas fa-circle-plus me-2"></i>
                        {{ 'saint.add_new'|trans({'default': 'Add New Saint'}, 'saint') }}
                    </a>
                    {% endif %}
                </div>
            </div>

                <div class="filter-bar {% if filter or app.request.query.get('q') or include_incomplete %}d-block{% else %}d-none{% endif %}" data-filter-toggle-target="filter" data-controller="autosubmit">
                    <form method="get" class="filter-form" style="width: 100%; display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;" data-action="change->autosubmit#submit">
                        <div class="search-box position-relative" style="flex: 1; min-width: 200px;">
                            <input type="text" 
                                   name="q"
                                   value="{{ app.request.query.get('q') }}"
                                   placeholder="{{ 'saint.filter.placeholder'|trans({'default': 'Search saints...'}, 'saint') }}" 
                                   id="saintSearch"
                                   style="padding-right: 3rem;" 
                                   onkeydown="if(event.key === 'Enter'){this.form.submit()}"/>
                            <button type="submit" class="search-clear-btn" style="border: none; background: none; outline: none;">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                        <select class="filter-select" id="filter" name="filter">
                            <option value="">{{ 'saint.filter.allsaints'|trans({}, 'saint') }}</option>
                            {% for status in canonical_statuses %}
                                <option value="{{ status.value }}" {% if filter == status.value %}selected{% endif %}>
                                    {{ status.getTitleTransKey()|trans({}, 'saint') }}
                                </option>
                            {% endfor %}
                        </select>

                        {% if is_granted('ROLE_ADMIN') %}
                            <div class="form-check form-switch ms-2">
                                <input class="form-check-input" type="checkbox" name="include_incomplete" id="include_incomplete" value="1" {% if include_incomplete %}checked{% endif %}>
                                <label class="form-check-label text-white" for="include_incomplete">
                                    {{ 'saint.filter.include_incomplete'|trans({}, 'saint') }}
                                </label>
                            </div>
                        {% endif %}

                        {% if is_granted('ROLE_ADMIN') or app.request.query.get('q') or filter or include_incomplete %}
                            <a href="{{ path('app_saint_index') }}" class="btn btn-outline-secondary">
                                <i class="fas fa-circle-xmark"></i>
                                {{ 'relic.actions.clear'|trans({}, 'relic') }}
                            </a>
                        {% endif %}
                    </form>
                </div>
        </div>

        {% if pagination.items|length > 0 %}
            <div class="relics-grid">
                {% for saint in pagination %}
                    <div class="saint-card" style="cursor: pointer;" 
                         data-controller="link" 
                         data-link-url-value="{{ path('app_saint_show', {'id': saint.id}) }}" 
                         data-action="click->link#click">
                        <div class="saint-image">
                            {% if saint.images is defined and saint.images|length > 0 %}
                                <div data-controller="image-loader">
                                    <div data-image-loader-target="skeleton" class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center">
                                        <img src="{{ asset('/images/relic.png') }}" class="w-100 h-100 skeleton-animation" style="object-fit: contain; filter: grayscale(100%);" />
                                    </div>
                                    <img data-image-loader-target="image" 
                                         data-action="load->image-loader#imageLoaded" 
                                         src="{{ image_url(saint.images.first.thumbnailFilename ?? saint.images.first.filename) }}" 
                                         alt="{{ saint|format_saint_name }}" />
                                </div>
                            {% else %}
                                <img src="{{ asset('/images/relic.png') }}" 
                                     alt="{{ 'saint.no_image_available'|trans({}, 'saint') }}" 
                                     class="opacity-25" 
                                     style="filter: grayscale(100%);" />
                            {% endif %}
                        </div>
                        <div class="saint-info">
                            <h3 class="saint-name">
                                {{ saint|format_saint_name }}
                                {% if saint.isIncomplete %}
                                    <span class="badge bg-warning text-dark ms-2" style="font-size: 0.7rem;">{{ 'admin.saints.incomplete.badge'|trans({}, 'admin') }}</span>
                                {% endif %}
                            </h3>
                            {% if saint.canonicalStatus %}
                                <p class="saint-dates">{{ saint.canonicalStatus.getTitleTransKey()|trans({}, 'saint') }}</p>
                            {% endif %}
                            <div class="relic-details">
                                {% if saint.feastDate %}
                                    <p class="relic-location">
                                        <strong>{{ 'saint.table.feast_date'|trans({}, 'saint') }}:</strong> 
                                        {{ saint.feastDate|format_date('medium', pattern=('common.date_formats.feast_date'|trans({}, 'common'))) }}
                                    </p>
                                {% endif %}
                                {% if saint.saintPhrase %}
                                    <p class="saint-bio">{{ saint.getTranslatedPhrase(app.request.locale)|slice(0, 150) }}{% if saint.getTranslatedPhrase(app.request.locale)|length > 150 %}...{% endif %}</p>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div class="pagination-wrapper">
                <div class="pagination-info">
                    {{ 'common.pagination.info'|trans({
                        '%start%': (pagination.getCurrentPageNumber() - 1) * pagination.getItemNumberPerPage() + 1,
                        '%end%': min(pagination.getCurrentPageNumber() * pagination.getItemNumberPerPage(), pagination.getTotalItemCount),
                        '%total%': pagination.getTotalItemCount
                    }, 'common') }}
                </div>
                <div class="navigation">
                    {{ knp_pagination_render(pagination) }}
                </div>
            </div>
        {% else %}
            <div class="no-relics-container fade-in">
                <div class="no-relics-content">
                    <div class="no-relics-icon">
                        <img src="{{ asset('/images/relic.png') }}" alt="{{ 'saint.no_saints'|trans({}, 'saint') }}" />
                    </div>
                    <h3 class="no-relics-title">{{ 'saint.no_saints'|trans({}, 'saint') }}</h3>
                    <p class="no-relics-text">{{ 'saint.no_saints_description'|trans({}, 'saint') }}</p>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_saint_new') }}" class="btn btn-primary no-relics-btn">
                            <i class="fas fa-plus-circle me-2"></i>
                            {{ 'saint.add_new'|trans({}, 'saint') }}
                        </a>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </section>
{% endblock %}
