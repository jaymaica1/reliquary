{% extends 'landing_base.html.twig' %}

{% block meta_description %}<meta name="description" content="{{ saint.saintPhrase|slice(0, 160) }}">{% endblock %}
{% block og_title %}{{ saint|format_saint_name }} - Reliquary{% endblock %}
{% block og_description %}{{ saint.saintPhrase|slice(0, 200) }}{% endblock %}
{% block og_image %}{% if saint.images is defined and saint.images|length > 0 %}{{ absolute_url(image_url(saint.images.first.filename)) }}{% else %}{{ parent() }}{% endif %}{% endblock %}

{% block structured_data %}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "{{ saint|format_saint_name }}",
    "description": "{{ saint.saintPhrase|slice(0, 200) }}"
}
</script>
{% endblock %}

{% block title %}{{ saint|format_saint_name }} - {{ 'saint.show_title'|trans({}, 'saint') }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/saint-show.css') }}">
{% endblock %}

{% block body %}
    <div class="saint-show-page">
        <div class="saint-show-container">

            <!-- Back to Saints Link -->
            <a href="{{ path('app_saint_index') }}" class="back-link">
                <span>←</span> {{ 'saint.actions.back'|trans({}, 'saint') }}
            </a>

            <!-- Main Content: Image and Details -->
            <div class="saint-content">
                <!-- Image Section -->
                <div class="saint-image-section">
                    {% if saint.images is defined and saint.images|length > 0 %}
                        <img src="{{ image_url(saint.images.first.filename) }}"
                             alt="{{ saint|format_saint_name }}"
                             class="saint-main-image">
                    {% else %}
                        <img src="{{ asset('/images/relic.png') }}"
                             alt="{{ 'saint.no_image_available'|trans({}, 'saint') }}"
                             class="saint-main-image"
                             style="opacity: 0.3; max-width: 200px;">
                    {% endif %}
                </div>

                <!-- Details Section -->
                <div class="saint-details-section">
                    <!-- Main Info Section -->
                    <div class="saint-section">
                        <h2 class="section-heading">{{ saint|format_saint_name }}</h2>

                        {% if saint.canonicalStatus %}
                            <div class="detail-item">
                                <span class="detail-label">{{ 'saint.table.canonical_status'|trans({}, 'saint') }}:</span>
                                <span class="detail-value">{{ saint.canonicalStatus.getLabel() }} ({{ saint.canonicalStatus.getTitleTransKey()|trans({}, 'saint') }})</span>
                            </div>
                        {% endif %}

                        {% if saint.feastDate %}
                            <div class="detail-item">
                                <span class="detail-label">{{ 'saint.table.feast_date'|trans({}, 'saint') }}:</span>
                                <span class="detail-value">{{ saint.feastDate|format_date('medium', pattern=('common.date_formats.feast_date'|trans({}, 'common'))) }}</span>
                            </div>
                        {% endif %}

                        {% if saint.canonizationDate %}
                            <div class="detail-item">
                                <span class="detail-label">{{ 'saint.table.canonization_date'|trans({}, 'saint') }}:</span>
                                <span class="detail-value">{{ saint.canonizationDate|date('Y-m-d') }}</span>
                            </div>
                        {% endif %}

                        {% if saint.url %}
                            <div class="detail-item">
                                <span class="detail-label">{{ 'saint.table.url'|trans({}, 'saint') }}:</span>
                                <span class="detail-value">
                                    <a href="{{ saint.url }}" target="_blank" rel="noopener noreferrer">{{ saint.url }}</a>
                                </span>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- Saint Phrase Quote -->
            {% if saint.getTranslatedPhrase(app.request.locale) %}
                <div class="saint-quote">
                    <p class="quote-text">
                        "{{ saint.getTranslatedPhrase(app.request.locale) }}"
                    </p>
                </div>
            {% endif %}

            <!-- Thumbnail Gallery -->
            {% if saint.images is defined and saint.images|length > 1 %}
                <div class="thumbnail-gallery">
                    {% for image in saint.images %}
                        <div class="thumbnail-item" data-controller="link"
                             data-link-url-value="{{ image_url(image.filename) }}" data-action="click->link#click">
                            <img src="{{ image_url(image.thumbnailFilename ?? image.filename) }}"
                                 alt="{{ 'saint.table.images'|trans({'default': 'Image'}, 'saint') }} {{ loop.index }}"
                                 class="thumbnail-image">
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            <!-- Relics Section -->
            {% if saint.relics is defined and saint.relics|length > 0 %}
                <div class="relics-section">
                    <h2 class="section-heading">{{ 'saint.table.relics'|trans({}, 'saint') }}</h2>
                    {{ include('relic/_relic_grid.html.twig') }}
                </div>
            {% endif %}

            <!-- Action Buttons -->
            <div class="saint-actions">
                <div class="action-group">
                    <!-- Empty left side for consistency with relic page -->
                </div>

                <div class="action-group">
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_saint_edit', {'id': saint.id}) }}" class="btn-action btn-outline">
                            <i class="fas fa-pencil"></i>
                            {{ 'saint.actions.edit'|trans({}, 'saint') }}
                        </a>
                        <form method="post" action="{{ path('app_saint_delete', {'id': saint.id}) }}"
                              onsubmit="return confirm('{{ 'saint.confirm_delete'|trans({'default': 'Are you sure you want to delete this saint?'}, 'saint') }}');"
                              style="display: inline;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ saint.id) }}">
                            <button type="submit" class="btn-action btn-danger-action">
                                <i class="fas fa-trash"></i>
                                {{ 'saint.actions.delete'|trans({'default': 'Delete'}, 'saint') }}
                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
