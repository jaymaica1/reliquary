{% extends 'landing_base.html.twig' %}

{% block title %}{{ 'about.title'|trans({}, 'about') }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/landing.css') }}">
    <style>
        .legal-card {
            background: rgba(254, 254, 254, 0.05);
            border: 1px solid rgba(245, 158, 11, 0.2);
            border-radius: 15px;
            padding: 3rem;
            transition: all 0.3s ease;
            position: relative;
        }
        .legal-card:hover {
            border-color: var(--accent-gold);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }
    </style>
{% endblock %}

{% block body %}
<section class="relic-classes" style="padding-top: 120px; padding-bottom: 80px;">
    <div class="contact-container">
        <h2 class="section-title">{{ 'about.title'|trans({}, 'about') }}</h2>
        <p class="section-subtitle">{{ 'about.subtitle'|trans({}, 'about') }}</p>

        <div class="row mt-5">
            <div class="col-12">
                <div class="legal-card text-start mb-5">
                    <div class="row align-items-center">
                        <div class="col-md-3 text-center mb-4 mb-md-0">
                            <img src="{{ asset('/images/relic.png') }}" alt="{{ 'common.logo'|trans({}, 'common') }}" class="img-fluid" style="max-width: 150px; filter: sepia(100%) saturate(300%) brightness(95%) hue-rotate(345deg);">
                        </div>
                        <div class="col-md-9">
                            <h3 class="relic-title" style="color: var(--accent-gold);">{{ 'about.what_is_reliquary.title'|trans({}, 'about') }}</h3>
                            <p class="relic-description" style="font-size: 1.1rem; color: rgba(254, 254, 254, 0.9);">
                                {{ 'about.what_is_reliquary.description'|trans({}, 'about') }}
                            </p>
                        </div>
                    </div>
                </div>

                <h2 class="section-title mt-5 mb-4">{{ 'about.features.title'|trans({}, 'about') }}</h2>
                <div class="classes-grid mt-4" id="guidelines">
                    <div class="relic-card" style="cursor: default;">
                        <i class="fas fa-database relic-icon"></i>
                        <h3 class="relic-title">{{ 'about.features.comprehensive_database.title'|trans({}, 'about') }}</h3>
                        <p class="relic-description">{{ 'about.features.comprehensive_database.description'|trans({}, 'about') }}</p>
                    </div>

                    <div class="relic-card" style="cursor: default;">
                        <i class="fas fa-user-friends relic-icon"></i>
                        <h3 class="relic-title">{{ 'about.features.saint_information.title'|trans({}, 'about') }}</h3>
                        <p class="relic-description">{{ 'about.features.saint_information.description'|trans({}, 'about') }}</p>
                    </div>

                    <div class="relic-card" style="cursor: default;">
                        <i class="fas fa-map-marker-alt relic-icon"></i>
                        <h3 class="relic-title">{{ 'about.features.geolocation_search.title'|trans({}, 'about') }}</h3>
                        <p class="relic-description">{{ 'about.features.geolocation_search.description'|trans({}, 'about') }}</p>
                    </div>

                    <div class="relic-card" style="cursor: default;">
                        <i class="fas fa-users relic-icon"></i>
                        <h3 class="relic-title">{{ 'about.features.user_contributions.title'|trans({}, 'about') }}</h3>
                        <p class="relic-description">{{ 'about.features.user_contributions.description'|trans({}, 'about') }}</p>
                    </div>

                    <div class="relic-card" style="cursor: default;">
                        <i class="fas fa-language relic-icon"></i>
                        <h3 class="relic-title">{{ 'about.features.multilingual_support.title'|trans({}, 'about') }}</h3>
                        <p class="relic-description">{{ 'about.features.multilingual_support.description'|trans({}, 'about') }}</p>
                    </div>
                </div>

                <div id="relic-classes" class="legal-card mt-5 text-start">
                    <h2 class="section-title mb-4">{{ 'about.relic_classes.title'|trans({}, 'about') }}</h2>
                    <p class="relic-description mb-4" style="font-size: 1.1rem; color: rgba(254, 254, 254, 0.9);">
                        {{ 'about.relic_classes.intro'|trans({}, 'about') }}
                    </p>
                    <div class="row">
                        <div class="col-md-4 mb-4">
                            <h3 class="relic-title" style="color: var(--accent-gold); font-size: 1.15rem;">{{ 'about.relic_classes.first.title'|trans({}, 'about') }}</h3>
                            <p class="relic-description">{{ 'about.relic_classes.first.body'|trans({}, 'about') }}</p>
                        </div>
                        <div class="col-md-4 mb-4">
                            <h3 class="relic-title" style="color: var(--accent-gold); font-size: 1.15rem;">{{ 'about.relic_classes.second.title'|trans({}, 'about') }}</h3>
                            <p class="relic-description">{{ 'about.relic_classes.second.body'|trans({}, 'about') }}</p>
                        </div>
                        <div class="col-md-4 mb-4">
                            <h3 class="relic-title" style="color: var(--accent-gold); font-size: 1.15rem;">{{ 'about.relic_classes.third.title'|trans({}, 'about') }}</h3>
                            <p class="relic-description">{{ 'about.relic_classes.third.body'|trans({}, 'about') }}</p>
                        </div>
                    </div>
                </div>

                <div id="authentication" class="legal-card mt-5 text-start">
                    <h2 class="section-title mb-4">{{ 'about.authentication.title'|trans({}, 'about') }}</h2>
                    <p class="relic-description mb-4" style="font-size: 1.1rem;">
                        {{ 'about.authentication.description'|trans({}, 'about') }}
                    </p>
                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <div class="relic-card h-100" style="cursor: default; background: rgba(254, 254, 254, 0.03);">
                                <i class="fas fa-id-card-alt relic-icon"></i>
                                <h3 class="relic-title">{{ 'about.authentication.process.contact_custodian.title'|trans({}, 'about') }}</h3>
                                <p class="relic-description">{{ 'about.authentication.process.contact_custodian.description'|trans({}, 'about') }}</p>
                            </div>
                        </div>
                        <div class="col-md-6 mb-4">
                            <div class="relic-card h-100" style="cursor: default; background: rgba(254, 254, 254, 0.03);">
                                <i class="fas fa-history relic-icon"></i>
                                <h3 class="relic-title">{{ 'about.authentication.process.verify_provenance.title'|trans({}, 'about') }}</h3>
                                <p class="relic-description">{{ 'about.authentication.process.verify_provenance.description'|trans({}, 'about') }}</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="legal-card mt-5 text-center" style="background: rgba(245, 158, 11, 0.05); border-color: var(--accent-gold);">
                    <h3 class="relic-title">{{ 'about.contact.title'|trans({}, 'about') }}</h3>
                    <p class="relic-description mb-4">
                        {{ 'about.contact.description'|trans({}, 'about') }}
                        <a href="https://github.com/CesarScur/reliquary" target="_blank" class="gold-link">{{ 'about.contact.github_repository'|trans({}, 'about') }}</a>.
                    </p>
                    <a href="https://github.com/CesarScur/reliquary" target="_blank" class="btn btn-primary">
                        <i class="fab fa-github me-2"></i>{{ 'common.footer.view_on_github'|trans({}, 'common') }}
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}