<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{{ 'contact.confirmation.subject'|trans({}, 'landing') }}</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            background-color: #4a5568;
            color: white;
            padding: 20px;
            text-align: center;
        }
        .content {
            padding: 20px;
            background-color: #f7fafc;
        }
        .footer {
            margin-top: 20px;
            padding: 15px;
            text-align: center;
            font-size: 0.9em;
            color: #718096;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>{{ 'contact.confirmation.title'|trans({}, 'landing') }}</h1>
        </div>
        <div class="content">
            <p>{{ 'contact.confirmation.greeting'|trans({'%name%': name}, 'landing') }}</p>

            <p>{{ 'contact.confirmation.message'|trans({}, 'landing') }}</p>

            <p>{{ 'contact.confirmation.response_time'|trans({}, 'landing') }}</p>

            <p>{{ 'contact.confirmation.signature'|trans({}, 'landing') }}<br>
            <strong>Reliquary Team</strong></p>
        </div>
        <div class="footer">
            <p>{{ 'contact.confirmation.footer'|trans({}, 'landing') }}</p>
        </div>
    </div>
</body>
</html>
