{# Relic rejected email template #}
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title>Your relic submission was not accepted</title>
  </head>
  <body style="font-family: Arial, sans-serif; line-height: 1.6; color: #111827;">
    <p>Hello{% if userName is defined and userName %} {{ userName }}{% endif %},</p>

    <p>Your relic of <strong>{{ relic.saint.name }}</strong> was not accepted.</p>

    {% if relic.rejectionReason %}
      <p><strong>Reason:</strong> {{ relic.rejectionReason }}</p>
    {% endif %}

    <p>You can make changes and resubmit your relic at any time.</p>

    <p style="color:#6b7280; font-size: 12px; margin-top: 2rem;">
      This is an automated message from Santa's Relíquias.
    </p>
  </body>
</html>
