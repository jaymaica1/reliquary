<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>New Contact Form Submission</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .header {
            background-color: #4a5568;
            color: white;
            padding: 20px;
            text-align: center;
        }
        .content {
            padding: 20px;
            background-color: #f7fafc;
        }
        .field {
            margin-bottom: 15px;
        }
        .field-label {
            font-weight: bold;
            color: #2d3748;
        }
        .field-value {
            margin-top: 5px;
            padding: 10px;
            background-color: white;
            border-left: 3px solid #4299e1;
        }
        .message-content {
            white-space: pre-wrap;
        }
        .admin-link {
            text-align: center;
            margin-top: 20px;
            padding: 15px;
            background-color: #4299e1;
        }
        .admin-link a {
            color: white;
            text-decoration: none;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>New Contact Form Submission</h1>
        </div>
        <div class="content">
            <div class="field">
                <div class="field-label">Name:</div>
                <div class="field-value">{{ name }}</div>
            </div>

            <div class="field">
                <div class="field-label">Email:</div>
                <div class="field-value">{{ contactEmail }}</div>
            </div>

            <div class="field">
                <div class="field-label">Subject:</div>
                <div class="field-value">{{ subject }}</div>
            </div>

            <div class="field">
                <div class="field-label">Message:</div>
                <div class="field-value message-content">{{ contactMessage }}</div>
            </div>

            {% if contactId is defined %}
            <div class="admin-link">
                <a href="{{ url('admin_contact_show', {id: contactId}) }}">View in Admin Panel</a>
            </div>
            {% endif %}
        </div>
    </div>
</body>
</html>
