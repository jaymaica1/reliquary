<div class="filter-header">
    <div class="filter-header-content">
        {% if app.request.get('_route') == 'app_relic_index' %}
        <button type="button" class="btn btn-secondary" data-action="filter-toggle#toggle">
            <i class="fas fa-eye" data-filter-toggle-target="icon"></i>
            {{ 'relic.filter.button'|trans({}, 'relic') }}
        </button>
        {% endif %}
        {% if is_granted('ROLE_USER') %}
        <a href="{{ path('app_relic_new') }}" class="btn btn-primary">
            <i class="fas fa-circle-plus me-2"></i>
            {{ 'relic.add_new'|trans({}, 'relic') }}
        </a>
        {% endif %}
    </div>
</div>
