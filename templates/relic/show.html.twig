{% extends 'landing_base.html.twig' %}

{% block title %}{{ relic.saint ? relic.saint|format_saint_name : 'Unknown Saint' }} - {{ 'relic.show_title'|trans({}, 'relic') }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/relic-show.css') }}">
{% endblock %}

{% block body %}
    <div class="relic-show-page">
        <div class="relic-show-container">

            <!-- Back to Relics Link -->
            <a href="{{ path('app_relic_index') }}" class="back-link">
                <span>←</span> {{ 'relic.actions.back_to_relics'|trans({'default': 'Back to Relics'}, 'relic') }}
            </a>

            <!-- Relic Header with Title and Badge -->
{#            <div class="relic-header">#}
{#                <h1 class="relic-title">#}
{#                    {{ 'relic.title_of'|trans({'default': 'Relic of'}, 'relic') }} {{ relic.saint ? relic.saint|format_saint_name : 'Unknown Saint' }}#}
{#                </h1>#}
{#                <span class="relic-badge">#}
{#                {{ relic.degree.getTitleTransKey()|trans({}, 'relic') }}#}
{#            </span>#}
{#            </div>#}

            <!-- Main Content: Image and Details -->
            <div class="relic-content">
                <!-- Image Section -->
                <div class="relic-image-section">
                    {% if relic.images|length > 0 %}
                        <img src="{{ image_url(relic.images[0].filename) }}"
                             alt="{{ relic.saint ? relic.saint|format_saint_name : 'Unknown Saint' }}"
                             class="relic-main-image">
                    {% else %}
                        <img src="{{ asset('/images/relic.png') }}"
                             alt="{{ 'relic.no_image'|trans({}, 'relic') }}"
                             class="relic-main-image"
                             style="opacity: 0.3; max-width: 200px;">
                    {% endif %}
                </div>

                <!-- Details Section -->
                <div class="relic-details-section">
                    <!-- Description Section -->
                    <div class="relic-section">
                        <h2 class="section-heading">{{ 'relic.relic_of'|trans({}, 'relic') }}
                            <a href="{{ path('app_saint_show', {'id': relic.saint.id}) }}">
                                {{ relic.saint|format_saint_name }}
                            </a>
                        </h2>

                        {% if relic.description %}
                            <p class="historical-text">{{ relic.description }}</p>
                        {% endif %}

                        <div class="detail-item">
                            <span class="detail-label">{{ 'relic.form.degree'|trans({}, 'relic') }}:</span>
                            <span class="detail-value">{{ relic.degree.getTitleTransKey()|trans({}, 'relic') }}</span>
                        </div>

                        {% if relic.provenance and (is_granted('ROLE_ADMIN')) %}
                            <div class="detail-item">
                                <span class="detail-label">{{ 'relic.form.provenance'|trans({'default': 'Provenance'}, 'relic') }}:</span>
                                <span class="detail-value">{{ relic.provenance }}</span>
                            </div>
                        {% endif %}

                        {% if relic.location %}
                            <div class="detail-item">
                                <span class="detail-label">{{ 'relic.form.location'|trans({}, 'relic') }}:</span>
                                <span class="detail-value">{{ relic.location }}</span>
                            </div>
                        {% endif %}

                        {% if relic.address %}
                            <div class="detail-item">
                                <span class="detail-label">{{ 'relic.form.address'|trans({}, 'relic') }}:</span>
                                <span class="detail-value">{{ relic.address }}</span>
                            </div>
                        {% endif %}

                        <div class="detail-item">
                            <span class="detail-label">{{ 'relic.table.status'|trans({}, 'relic') }}:</span>
                            <span class="detail-value">
                            {% if relic.status == constant('App\\Enum\\RelicStatus::PENDING') %}
                                <span class="status-badge status-pending">{{ relic.status.getTitleTransKey()|trans({}, 'relic') }}</span>
                            {% elseif relic.status == constant('App\\Enum\\RelicStatus::APPROVED') %}
                                <span class="status-badge status-approved">{{ relic.status.getTitleTransKey()|trans({}, 'relic') }}</span>
                            {% elseif relic.status == constant('App\\Enum\\RelicStatus::REJECTED') %}
                                {% if app.user and relic.creator and app.user.id == relic.creator.id %}
                                    <span class="status-badge status-rejected">{{ 'relic.status.not_accepted'|trans({'default': 'Not Accepted'}, 'relic') }}</span>
                                {% else %}
                                    <span class="status-badge status-rejected">{{ relic.status.getTitleTransKey()|trans({}, 'relic') }}</span>
                                {% endif %}
                            {% endif %}
                        </span>
                        </div>

                        {% if relic.status == constant('App\\Enum\\RelicStatus::REJECTED') and relic.rejectionReason and app.user and relic.creator and app.user.id == relic.creator.id %}
                            <div class="rejection-reason">
                                <span class="rejection-reason-label">{{ 'relic.rejection_reason'|trans({'default': 'Reason'}, 'relic') }}:</span>
                                <p class="rejection-reason-text">{{ relic.rejectionReason }}</p>
                            </div>
                        {% endif %}

                        <div class="detail-item">
                            <span class="detail-label">{{ 'relic.table.added_by'|trans({}, 'relic') }}:</span>
                            <span class="detail-value">{{ relic.creator.username }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Historical Significance Section -->
        {% if relic.description and false %}
            <div class="historical-section">
                <h2 class="section-heading">{{ 'relic.historical_significance'|trans({'default': 'Historical Significance'}, 'relic') }}</h2>
                <p class="historical-text">
                    {{ relic.description }}
                </p>
            </div>
        {% endif %}

        <!-- Thumbnail Gallery -->
        {% if relic.images|length > 1 %}
            <div class="thumbnail-gallery">
                {% for image in relic.images %}
                    <div class="thumbnail-item" data-controller="link"
                         data-link-url-value="{{ image_url(image.filename) }}" data-action="click->link#click">
                        <img src="{{ image_url(image.thumbnailFilename ?? image.filename) }}"
                             alt="{{ 'relic.image'|trans({'default': 'Relic Image'}, 'relic') }} {{ loop.index }}"
                             class="thumbnail-image">
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        <!-- Action Buttons -->
        <div class="relic-actions">
            <div class="action-group">
                {% if relic.latitude is not null and relic.longitude is not null %}
                    <a href="https://www.google.com/maps?q={{ relic.latitude }},{{ relic.longitude }}"
                       class="btn-action btn-success-action"
                       target="_blank"
                       rel="noopener noreferrer">
                        <i class="fas fa-map-marker-alt"></i>
                        {{ 'relic.actions.visit_maps'|trans({}, 'relic') }}
                    </a>
                {% endif %}
            </div>

            <div class="action-group">
                {% if relic.status == constant('App\\Enum\\RelicStatus::REJECTED') and app.user and relic.creator and app.user.id == relic.creator.id %}
                    <a href="{{ path('app_relic_resubmit', {'id': relic.id}) }}" class="btn-action btn-primary-action">
                        <i class="fas fa-redo"></i>
                        {{ 'relic.actions.resubmit'|trans({'default': 'Resubmit'}, 'relic') }}
                    </a>
                {% endif %}

                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_relic_edit', {'id': relic.id}) }}" class="btn-action btn-outline">
                        <i class="fas fa-pencil"></i>
                        {{ 'relic.actions.edit'|trans({}, 'relic') }}
                    </a>
                    <form method="post" action="{{ path('app_relic_delete', {'id': relic.id}) }}"
                          onsubmit="return confirm('{{ 'relic.confirm_delete'|trans({'default': 'Are you sure you want to delete this relic?'}, 'relic') }}');"
                          style="display: inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ relic.id) }}">
                        <button type="submit" class="btn-action btn-danger-action">
                            <i class="fas fa-trash"></i>
                            {{ 'relic.actions.delete'|trans({}, 'relic') }}
                        </button>
                    </form>
                {% endif %}
            </div>
        </div>
    </div>
    </div>
{% endblock %}
