{% extends 'landing_base.html.twig' %}

{% block title %}{{ title ?? 'relic.title'|trans({}, 'relic') }}{% endblock %}

{% block body %}
    <section class="list">
        <h1 class="section-title">{{ title ?? 'relic.title'|trans({}, 'relic') }}</h1>
        <p class="section-subtitle">{{ 'relic.subtitle'|trans({}, 'relic') }}</p>

        <div class="filter-section" data-controller="filter-toggle">
            {{ include('relic/_header.html.twig') }}

            <div class="filter-bar {% if not (filter or query or location or (distance and distance != 50)) %}d-none{% endif %}" data-filter-toggle-target="filter">
                <form method="get" class="filter-form" style="width: 100%; display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
                    <div class="search-box position-relative">
                        <input type="text" name="q" value="{{ query }}" placeholder="{{ 'relic.search.placeholder'|trans({}, 'relic')|default('Search relics...') }}" id="relicSearch" style="padding-right: 3rem;" />
                        <button type="submit" class="search-clear-btn" style="border: none; background: none; outline: none;">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                    <div class="search-box position-relative" data-controller="address-autocomplete">
                        <input type="text" name="location" value="{{ location }}" placeholder="{{ 'relic.form.address_placeholder'|trans({}, 'relic') }}" id="relicLocation" data-address-autocomplete-target="input" data-action="input->address-autocomplete#onInput" autocomplete="off" style="padding-right: 3rem;" />
                        <input type="hidden" name="lat" value="{{ app.request.query.get('lat') }}" data-address-autocomplete-target="lat" />
                        <input type="hidden" name="lng" value="{{ app.request.query.get('lng') }}" data-address-autocomplete-target="lng" />
                        <div class="autocomplete-results d-none" data-address-autocomplete-target="results"></div>
                        <button type="button" class="search-clear-btn" data-action="address-autocomplete#getCurrentLocation" title="{{ 'relic.actions.get_current_location'|trans({}, 'relic')|default('Get current location') }}">
                            <i class="fas fa-location-crosshairs"></i>
                        </button>
                    </div>
                    <div class="distance-slider-wrapper" style="display: flex; align-items: center; gap: 0.5rem; color: var(--sacred-white); min-width: 200px;" data-controller="range-value">
                        <label for="distanceRange" class="form-label mb-0" style="white-space: nowrap;">{{ 'relic.filter.distance'|trans({}, 'relic')|default('Distance') }}: <span id="distanceValue" data-range-value-target="output">{{ distance }}</span>km</label>
                        <input type="range" class="form-range" name="distance" min="1" max="500" step="1" id="distanceRange" value="{{ distance }}" 
                               data-action="input->range-value#update change->autosubmit#submit"
                               data-controller="autosubmit">
                    </div>
                    <select class="filter-select" id="filter" name="filter" data-controller="autosubmit" data-action="change->autosubmit#submit">
                        <option value="">{{ 'relic.filter.all_relics'|trans({}, 'relic') }}</option>
                        {% for degree in relic_degrees %}
                            <option value="{{ degree.value }}" {% if filter == degree.value %}selected{% endif %}>
                                {{ degree.getTitleTransKey|trans({}, 'relic') }}
                            </option>
                        {% endfor %}
                    </select>
                    {% if filter or query or location or distance != 50 %}
                        <a href="{{ app.request.get('_route') == 'app_my_relics' ? path('app_my_relics') : path('app_relic_index') }}" class="btn btn-outline-secondary">
                            <i class="fas fa-circle-xmark"></i>
                            {{ 'relic.actions.clear'|trans({}, 'relic') }}
                        </a>
                    {% endif %}
                </form>
            </div>
        </div>

        {% if location_data and relics_for_map|length > 0 %}
            <div class="map-container-wrapper mb-4" 
                 data-controller="map" 
                 data-map-translation-title-value="{{ 'common.cookie_consent.map_consent.title'|trans({}, 'common') }}"
                 data-map-translation-message-value="{{ 'common.cookie_consent.map_consent.message'|trans({}, 'common') }}"
                 data-map-translation-button-value="{{ 'common.cookie_consent.map_consent.button'|trans({}, 'common') }}"
                 data-map-relics-value="{{ relics_for_map|json_encode }}"
                 data-map-radius-value="{{ distance }}"
                 {% if location_data %}
                 data-map-user-location-value="{{ {latitude: location_data.lat, longitude: location_data.lng}|json_encode }}"
                 {% endif %}
            >
                <div id="map" style="height: 400px; width: 100%; border-radius: 12px; border: 1px solid var(--accent-gold);" data-map-target="container"></div>
            </div>
        {% endif %}

        {{ include('relic/_relic_grid.html.twig') }}

        {% if pagination.items|length == 0 %}
            <div class="no-relics-container fade-in">
                <div class="no-relics-content">
                    {% if app.user %}
                        <a href="{{ path('app_relic_new') }}" class="btn btn-primary no-relics-btn">
                            <i class="fas fa-plus-circle me-2"></i>
                            {{ 'relic.add_new'|trans({}, 'relic') }}
                        </a>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="btn btn-primary no-relics-btn">
                            {{ 'cta.login_to_submit'|trans({}, 'landing')|default('Login to Submit Relic') }}
                        </a>
                    {% endif %}
                </div>
            </div>
        {% endif %}
    </section>
{% endblock %}
