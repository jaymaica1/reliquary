{% extends 'landing_base.html.twig' %}

{% block title %}{{ 'security.reset_password.title'|trans({}, 'security') }}{% endblock %}

{% block body %}
<section class="contact-section">
    <div class="contact-container">
        <h2 class="section-title">{{ 'security.reset_password.title'|trans({}, 'security') }}</h2>
        
        <div class="contact-content contact-content-single">
            <div class="contact-form-section">
                <form class="contact-form" method="post">
                    {{ form_start(resetForm) }}

                    <div class="form-group">
                        <label for="{{ resetForm.plainPassword.first.vars.id }}">{{ 'security.reset_password.new_password'|trans({}, 'security') }}</label>
                        <div class="password-toggle-wrapper" data-controller="password-toggle">
                            {{ form_widget(resetForm.plainPassword.first, {'attr': {'class': '', 'data-password-toggle-target': 'input'}}) }}
                            <button type="button" data-action="password-toggle#toggle" class="password-toggle-btn">
                                <i class="fas fa-eye" data-password-toggle-target="icon"></i>
                            </button>
                        </div>
                        {{ form_errors(resetForm.plainPassword.first) }}
                    </div>

                    <div class="form-group">
                        <label for="{{ resetForm.plainPassword.second.vars.id }}">{{ 'security.reset_password.repeat_password'|trans({}, 'security') }}</label>
                        <div class="password-toggle-wrapper" data-controller="password-toggle">
                            {{ form_widget(resetForm.plainPassword.second, {'attr': {'class': '', 'data-password-toggle-target': 'input'}}) }}
                            <button type="button" data-action="password-toggle#toggle" class="password-toggle-btn">
                                <i class="fas fa-eye" data-password-toggle-target="icon"></i>
                            </button>
                        </div>
                        {{ form_errors(resetForm.plainPassword.second) }}
                    </div>

                    <button type="submit" class="btn btn-primary">
                        {{ 'security.reset_password.submit'|trans({}, 'security') }}
                    </button>

                    <div class="form-actions-center">
                        <p>
                            <a href="{{ path('app_login') }}" class="gold-link">{{ 'security.login.back_to_login'|trans({}, 'security') }}</a>
                        </p>
                    </div>

                    {{ form_end(resetForm) }}
                </form>
            </div>
        </div>
    </div>
</section>
{% endblock %}
