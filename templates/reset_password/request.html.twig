{% extends 'landing_base.html.twig' %}

{% block title %}{{ 'security.reset_password.title'|trans({}, 'security') }}{% endblock %}

{% block body %}
<section class="contact-section">
    <div class="contact-container">
        <h2 class="section-title">{{ 'security.reset_password.title'|trans({}, 'security') }}</h2>
        
        <div class="contact-content contact-content-single">
            <div class="contact-form-section">
                <form class="contact-form" method="post">
                    {{ form_start(requestForm) }}

                    <div class="form-group">
                        <label for="{{ requestForm.email.vars.id }}">{{ 'security.reset_password.email'|trans({}, 'security') }}</label>
                        {{ form_widget(requestForm.email, {'attr': {'class': '', 'type': 'email', 'required': true}}) }}
                        <small class="form-help">{{ 'security.reset_password.email_help'|trans({}, 'security') }}</small>
                        {{ form_errors(requestForm.email) }}
                    </div>

                    <button type="submit" class="btn btn-primary">
                        {{ 'security.reset_password.send_email'|trans({}, 'security') }}
                    </button>

                    <div class="form-actions-center">
                        <p>
                            <a href="{{ path('app_login') }}" class="gold-link">{{ 'security.login.back_to_login'|trans({}, 'security') }}</a>
                        </p>
                    </div>

                    {{ form_end(requestForm) }}
                </form>
            </div>
        </div>
    </div>
</section>
{% endblock %}
