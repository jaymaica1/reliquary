{% extends 'landing_base.html.twig' %}

{% block title %}{{ 'security.reset_password.email_sent_title'|trans({}, 'security') }}{% endblock %}

{% block body %}
<section class="contact-section">
    <div class="contact-container">
        <h2 class="section-title">{{ 'security.reset_password.email_sent_title'|trans({}, 'security') }}</h2>
        
        <div class="contact-content contact-content-single">
            <div class="contact-form-section">
                <div class="contact-form">
                    <div class="form-user-info mb-4">
                        <p>
                            {{ 'security.reset_password.email_sent_message'|trans({}, 'security') }}
                            {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
                        </p>
                    </div>

                    <div class="form-actions-center">
                        <p>
                            {{ 'security.reset_password.check_spam'|trans({}, 'security') }} 
                            <a href="{{ path('app_forgot_password_request') }}" class="gold-link">{{ 'security.reset_password.try_again'|trans({}, 'security') }}</a>
                        </p>
                        <p>
                            <a href="{{ path('app_login') }}" class="btn btn-secondary mt-4">
                                {{ 'security.login.back_to_login'|trans({}, 'security') }}
                            </a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
