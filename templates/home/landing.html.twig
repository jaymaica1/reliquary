{% extends 'landing_base.html.twig' %}

{% block title %}{{ 'home.title'|trans({}, 'home') }} - {{ 'home.welcome'|trans({}, 'home') }}{% endblock %}

{% block body %}

    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-content">
            <h1 class="hero-title">{{ 'common.reliquary'|trans({}, 'common') }}</h1>
            <p class="hero-subtitle">{{ 'hero.subtitle'|trans({}, 'landing') }}</p>
            <p class="hero-description">
                {{ 'hero.description'|trans({}, 'landing') }}
            </p>
            <div class="cta-buttons">
                <a href="{{ path('app_relic_index') }}"
                   class="btn btn-primary">{{ 'hero.explore_collection'|trans({}, 'landing') }}</a>
                {% if app.user %}
                    <a href="{{ path('app_relic_new') }}"
                       class="btn btn-secondary">{{ 'hero.submit_relic'|trans({}, 'landing') }}</a>
                {% else %}
                    <a href="{{ path('app_register') }}"
                       class="btn btn-secondary">{{ 'hero.join_now'|trans({}, 'landing') }}</a>
                {% endif %}
            </div>
        </div>
        <div class="scroll-indicator"></div>
    </section>

    <!-- Featured relics + compact class filters -->
    <section class="landing-featured-relics">
        <h2 class="section-title">{{ 'featured.title'|trans({}, 'landing') }}</h2>
        <div class="landing-featured-intro">
            <blockquote class="landing-featured-quote" cite="https://www.vatican.va/archive/bible/index.htm">
                <p>{{ 'featured.quote'|trans({}, 'landing') }} <cite class="landing-featured-cite">{{ 'featured.quote_ref'|trans({}, 'landing') }}</cite></p>
            </blockquote>
            <p class="landing-featured-body">{{ 'featured.body'|trans({}, 'landing') }}</p>
        </div>

        {% if landingShowcaseRelics is not empty %}
            <div class="landing-showcase-track" role="list">
                {% for relic in landingShowcaseRelics %}
                    <a href="{{ path('app_relic_show', {id: relic.id}) }}"
                       class="landing-showcase-card"
                       role="listitem">
                        <div class="landing-showcase-image-wrap">
                            {% if relic.images is defined and relic.images|length > 0 %}
                                <img src="{{ image_url(relic.images.first.thumbnailFilename ?? relic.images.first.filename) }}"
                                     alt="{% if relic.saint %}{{ relic.saint|format_saint_name }}{% else %}{{ 'featured.relic_image_alt'|trans({}, 'landing') }}{% endif %}"
                                     loading="lazy" />
                            {% endif %}
                        </div>
                        <div class="landing-showcase-info">
                            <h3 class="landing-showcase-saint">{{ relic.saint ? (relic.saint|format_saint_name) : '—' }}</h3>
                            <p class="landing-showcase-degree">{{ relic.degree.getTitleTransKey()|trans({}, 'relic') }}</p>
                            {% if relic.location %}
                                <p class="landing-showcase-location">{{ relic.location }}</p>
                            {% endif %}
                        </div>
                    </a>
                {% endfor %}
            </div>
        {% else %}
            <div class="landing-showcase-empty-wrap">
                <p class="landing-showcase-empty">{{ 'featured.empty'|trans({}, 'landing') }}</p>
                <a href="{{ path('app_relic_index') }}" class="btn btn-primary">{{ 'featured.browse_all'|trans({}, 'landing') }}</a>
            </div>
        {% endif %}

        <div class="landing-showcase-footer">
            <p class="landing-showcase-chips-label">{{ 'featured.filter_by_class'|trans({}, 'landing') }}</p>
            <div class="landing-class-chips" role="navigation" aria-label="{{ 'featured.filter_by_class'|trans({}, 'landing') }}">
                <a href="{{ path('app_relic_index', {filter: 'first-class'}) }}" class="landing-class-chip">{{ 'relic.degree.first_class'|trans({}, 'relic') }}</a>
                <a href="{{ path('app_relic_index', {filter: 'second-class'}) }}" class="landing-class-chip">{{ 'relic.degree.second_class'|trans({}, 'relic') }}</a>
                <a href="{{ path('app_relic_index', {filter: 'third-class'}) }}" class="landing-class-chip">{{ 'relic.degree.third_class'|trans({}, 'relic') }}</a>
            </div>
            <p class="landing-showcase-meta">
                <a href="{{ path('app_about') }}#relic-classes" class="landing-showcase-meta-link">{{ 'featured.about_classes'|trans({}, 'landing') }}</a>
                <span class="landing-showcase-meta-sep" aria-hidden="true">·</span>
                <a href="{{ path('app_about') }}#authentication" class="landing-showcase-meta-link">{{ 'featured.about_authentication'|trans({}, 'landing') }}</a>
            </p>
        </div>
    </section>

    <!-- Featured Saints Section -->
    <section class="featured-saints">
        <h2 class="section-title">{{ 'saints.title'|trans({}, 'landing') }}</h2>
        <p class="section-subtitle">{{ 'saints.subtitle'|trans({}, 'landing') }}</p>
        {% block saints_content %}
            <div class="saints-carousel" data-controller="carousel">
                {# Prepend Saint of the Day as a special card inside the carousel #}
                {% if saintOfDay %}
                <div class="saint-card saint-of-day" style="cursor: pointer;" data-controller="link" data-link-url-value="{{ path('app_saint_show', {'id': saintOfDay.id}) }}" data-action="click->link#click">
                        <div class="saint-image">
                            <div class="sod-label"><i class="fas fa-star me-1"></i> {{ 'home.saint_of_day'|trans({}, 'home')|default('Saint of the Day') }}</div>
                            {% if saintOfDay.images is defined and saintOfDay.images|length > 0 %}
                                <img src="{{ image_url(saintOfDay.images.first.thumbnailFilename ?? saintOfDay.images.first.filename) }}" alt="{{ saintOfDay.name }}" />
                            {% endif %}
                        </div>
                        <div class="saint-info">
                            <h3 class="saint-name">{{ saintOfDay|format_saint_name }}</h3>
                            {% if saintOfDay.feastDate %}
                                <p class="saint-dates">{{ saintOfDay.feastDate|format_date('medium', pattern=('common.date_formats.feast_date'|trans({}, 'common'))) }}</p>
                            {% endif %}
                            {% if saintOfDay.saintPhrase %}
                                <p class="saint-bio">{{ saintOfDay.getTranslatedPhrase(app.request.locale) }}</p>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}

                {# Render the rest of featured saints; avoid duplicating the SoD if present in the list #}
                {% for saint in featuredSaints %}
                    {% if not (saintOfDay and saint.id == saintOfDay.id) %}
                        <div class="saint-card" style="cursor: pointer;" data-controller="link" data-link-url-value="{{ path('app_saint_show', {'id': saint.id}) }}" data-action="click->link#click">
                        <div class="saint-image">
                            {% if saint.images.first %}
                                <img src="{{ image_url(saint.images.first.thumbnailFilename ?? saint.images.first.filename) }}" alt="{{ saint.name }}" />
                            {% endif %}
                        </div>
                        <div class="saint-info">
                            <h3 class="saint-name">{{ saint|format_saint_name }}</h3>
                            {% if saint.feastDate %}
                                <p class="saint-dates">{{ saint.feastDate|format_date('medium', pattern=('common.date_formats.feast_date'|trans({}, 'common'))) }}</p>
                            {% endif %}
                            <p class="saint-bio">
                                {{ saint.getTranslatedPhrase(app.request.locale) }}
                            </p>
                        </div>
                    </div>
                    {% endif %}
                {% else %}
                    {# Fallback example card if there are no featured saints at all #}
                    <div class="saint-card">
                        <div class="saint-image"></div>
                        <div class="saint-info">
                            <h3 class="saint-name">{{ 'saints.francis.name'|trans({}, 'landing') }}</h3>
                            <p class="saint-dates">{{ 'saints.francis.dates'|trans({}, 'landing') }}</p>
                            <p class="saint-bio">
                                {{ 'saints.francis.bio'|trans({}, 'landing') }}
                            </p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endblock %}
    </section>
{% endblock %}

