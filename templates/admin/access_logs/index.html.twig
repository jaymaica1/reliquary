{% extends 'admin_base.html.twig' %}

{% block title %}Access Logs - Admin{% endblock %}
{% block pageTitle %}Access Logs Management{% endblock %}

{% block body %}
    {% if statistics %}
        <div class="dashboard-widgets">
            <div class="widget-card primary-accent">
                <div class="widget-number">{{ statistics.totalAccesses ?? 0 }}</div>
                <div class="widget-label">Total Accesses</div>
                <div class="widget-trend">
                    <i class="fas fa-chart-line me-1"></i>
                    All Time
                </div>
            </div>

            <div class="widget-card gold-accent">
                <div class="widget-number">{{ statistics.uniqueUsers ?? 0 }}</div>
                <div class="widget-label">Unique Users</div>
                <div class="widget-trend">
                    <i class="fas fa-users me-1"></i>
                    Active
                </div>
            </div>

            <div class="widget-card success-accent">
                <div class="widget-number">
                    {% set successCount = 0 %}
                    {% if statistics.actionBreakdown %}
                        {% for item in statistics.actionBreakdown %}
                            {% if item.severity == 'success' or item.severity == 'info' %}
                                {% set successCount = successCount + 1 %}
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                    {{ successCount }}
                </div>
                <div class="widget-label">Successful Actions</div>
                <div class="widget-trend">
                    <i class="fas fa-check-circle me-1"></i>
                    Normal
                </div>
            </div>

            <div class="widget-card red-accent">
                <div class="widget-number">
                    {% set warningCount = 0 %}
                    {% if statistics.actionBreakdown %}
                        {% for item in statistics.actionBreakdown %}
                            {% if item.severity == 'warning' or item.severity == 'failure' %}
                                {% set warningCount = warningCount + 1 %}
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                    {{ warningCount }}
                </div>
                <div class="widget-label">Warnings/Failures</div>
                <div class="widget-trend">
                    <i class="fas fa-exclamation-triangle me-1"></i>
                    Requires Review
                </div>
            </div>
        </div>
    {% endif %}

    <!-- Filters -->
    <div class="content-section">
        <div class="section-header">
            <h5 class="card-title mb-0">
                <i class="fas fa-filter me-2"></i>Filters & Actions
            </h5>
        </div>
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-2">
                    <label for="action" class="form-label">Action</label>
                    <input type="text" class="form-control" id="action" name="action" 
                           value="{{ filters.action ?? '' }}" placeholder="e.g. auth.login">
                </div>
                <div class="col-md-2">
                    <label for="user_id" class="form-label">User ID</label>
                    <input type="text" class="form-control" id="user_id" name="user_id" 
                           value="{{ filters.userId ?? '' }}" placeholder="User identifier">
                </div>
                <div class="col-md-2">
                    <label for="severity" class="form-label">Severity</label>
                    <select class="form-select" id="severity" name="severity">
                        <option value="">All Severities</option>
                        {% for option in severity_options %}
                            <option value="{{ option }}" {{ (filters.severity ?? '') == option ? 'selected' : '' }}>
                                {{ option|title }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="date_from" class="form-label">Date From</label>
                    <input type="date" class="form-control" id="date_from" name="date_from" 
                           value="{{ filters.dateFrom ?? '' }}">
                </div>
                <div class="col-md-2">
                    <label for="date_to" class="form-label">Date To</label>
                    <input type="date" class="form-control" id="date_to" name="date_to" 
                           value="{{ filters.dateTo ?? '' }}">
                </div>
                <div class="col-md-2">
                    <label for="limit" class="form-label">Per Page</label>
                    <select class="form-select" id="limit" name="limit">
                        <option value="25" {{ limit == 25 ? 'selected' : '' }}>25</option>
                        <option value="50" {{ limit == 50 ? 'selected' : '' }}>50</option>
                        <option value="100" {{ limit == 100 ? 'selected' : '' }}>100</option>
                    </select>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-search me-1"></i>Filter
                    </button>
                    <a href="{{ path('app_admin_access_logs_index') }}" class="btn btn-outline-secondary">
                        <i class="fas fa-times me-1"></i>Clear
                    </a>
                    <a href="{{ path('app_admin_access_logs_export', app.request.query.all) }}" class="btn btn-outline-success">
                        <i class="fas fa-download me-1"></i>Export CSV
                    </a>
                    <a href="{{ path('app_admin_access_logs_statistics') }}" class="btn btn-outline-info">
                        <i class="fas fa-chart-bar me-1"></i>Detailed Statistics
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Access Logs Table -->
    <div class="content-section">
        <div class="card-body">
            {% if access_logs is empty %}
                <div class="text-center py-4 text-muted">
                    <i class="fas fa-list-ul fa-2x mb-2"></i>
                    <p>No access logs found for the selected criteria.</p>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th scope="col">Timestamp</th>
                                <th scope="col">User</th>
                                <th scope="col">Action</th>
                                <th scope="col">Path / Resource</th>
                                <th scope="col">Method</th>
                                <th scope="col">Response</th>
                                <th scope="col">Severity</th>
                                <th scope="col">IP Hash</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for log in access_logs %}
                            <tr>
                                <td>
                                    <small class="text-muted">{{ log.timestamp|date('Y-m-d') }}</small><br>
                                    <strong>{{ log.timestamp|date('H:i:s') }}</strong>
                                </td>
                                <td>
                                    {% if log.userId %}
                                        <span class="badge bg-primary">{{ log.userId }}</span>
                                    {% else %}
                                        <span class="text-muted">Anonymous</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <code class="small">{{ log.action }}</code>
                                </td>
                                <td>
                                    {% if log.path %}
                                        <div class="small text-truncate" style="max-width: 200px;" title="{{ log.path }}">
                                            <span class="text-muted">Path:</span> {{ log.path }}
                                        </div>
                                    {% endif %}
                                    {% if log.resource %}
                                        <div class="small text-truncate" style="max-width: 200px;" title="{{ log.resource }}">
                                            <span class="text-muted">Res:</span> {{ log.resource }}
                                        </div>
                                    {% elseif not log.path %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if log.httpMethod %}
                                        <span class="badge bg-secondary">{{ log.httpMethod }}</span>
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if log.responseCode %}
                                        {% set statusClass = log.responseCode >= 200 and log.responseCode < 300 ? 'success' : 
                                                           (log.responseCode >= 300 and log.responseCode < 400 ? 'warning' : 'danger') %}
                                        <span class="badge bg-{{ statusClass }}">{{ log.responseCode }}</span>
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% set severityClass = {
                                        'info': 'info',
                                        'success': 'success', 
                                        'warning': 'warning',
                                        'failure': 'danger'
                                    } %}
                                    <span class="badge bg-{{ severityClass[log.severity] ?? 'secondary' }}">
                                        {{ log.severity|title }}
                                    </span>
                                </td>
                                <td>
                                    <small class="font-monospace text-muted">{{ log.ipAddress[:8] }}...</small>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                
                <!-- Simple Pagination -->
                <div class="d-flex justify-content-between align-items-center mt-4 px-2">
                    <div class="text-muted small">
                        Showing {{ access_logs|length }} results (page {{ current_page }})
                    </div>
                    <div class="btn-group">
                        {% if current_page > 1 %}
                            <a href="{{ path('app_admin_access_logs_index', app.request.query.all|merge({'page': current_page - 1})) }}" 
                               class="btn btn-outline-primary">
                                <i class="fas fa-chevron-left"></i> Previous
                            </a>
                        {% endif %}
                        {% if has_more %}
                            <a href="{{ path('app_admin_access_logs_index', app.request.query.all|merge({'page': current_page + 1})) }}" 
                               class="btn btn-outline-primary">
                                Next <i class="fas fa-chevron-right"></i>
                            </a>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>

    <!-- Cleanup Section -->
    <div class="card shadow-sm mt-4">
        <div class="card-header bg-warning">
            <h5 class="card-title mb-0">
                <i class="fas fa-broom me-2"></i>Maintenance
            </h5>
        </div>
        <div class="card-body">
            <p class="text-muted mb-3">Clean up old access logs to maintain system performance and comply with data retention policies.</p>
            <form method="post" action="{{ path('app_admin_access_logs_cleanup') }}" class="d-inline">
                <input type="hidden" name="_token" value="{{ csrf_token('access_logs_cleanup') }}">
                <div class="row g-3 align-items-end">
                    <div class="col-auto">
                        <label for="days_to_keep" class="form-label">Keep logs from last</label>
                        <select name="days_to_keep" id="days_to_keep" class="form-select">
                            <option value="30">30 days</option>
                            <option value="90">90 days</option>
                            <option value="180">6 months</option>
                            <option value="365" selected>1 year</option>
                            <option value="730">2 years</option>
                        </select>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-warning" 
                                data-action="click->admin-base#confirm"
                                data-admin-base-confirm-value="Are you sure you want to delete old access logs? This action cannot be undone.">
                            <i class="fas fa-trash me-1"></i>Clean Up Old Logs
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
{% endblock %}