{% extends 'admin_base.html.twig' %}
{% block title %}Dashboard {% endblock %}
{% block pageTitle %}Dashboard{% endblock %}

{% block body %}
    <div class="dashboard-widgets">
        <div class="widget-card">
            <div class="widget-number">7</div>
            <div class="widget-label">Pending Relic Approvals</div>
            <div class="widget-trend">
                <i class="fas fa-arrow-up me-1"></i>
                2 new this week
            </div>
        </div>

        <div class="widget-card gold-accent">
            <div class="widget-number">847</div>
            <div class="widget-label">Active Community Members</div>
            <div class="widget-trend">
                <i class="fas fa-arrow-up me-1"></i>
                +12% this month
            </div>
        </div>

        <div class="widget-card success-accent">
            <div class="widget-number">23</div>
            <div class="widget-label">Saints Added This Month</div>
            <div class="widget-trend">
                <i class="fas fa-chart-line me-1"></i>
                On track
            </div>
        </div>

        <div class="widget-card">
            <div class="widget-number">73%</div>
            <div class="widget-label">Translation Progress</div>
            <div class="progress-custom mt-2">
                <div class="progress-bar-custom" style="width: 73%"></div>
            </div>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="content-section">
        <div class="section-header">
            <h5 class="mb-0">
                <i class="fas fa-clock me-2 text-primary"></i>
                Recent Activity
            </h5>
            <button class="btn btn-outline-primary btn-sm">
                <i class="fas fa-eye"></i>
                View All
            </button>
        </div>

        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                <tr>
                    <th>Time</th>
                    <th>Action</th>
                    <th>Item</th>
                    <th>Status</th>
                    <th>Admin</th>
                </tr>
                </thead>
                <tbody>
                <tr>
                    <td>10 min ago</td>
                    <td><i class="fas fa-shield-check text-success me-2"></i>Relic Approved</td>
                    <td>First-Class Relic of St. Francis</td>
                    <td><span class="status-badge status-approved">Approved</span></td>
                    <td>Admin Maria</td>
                </tr>
                <tr>
                    <td>25 min ago</td>
                    <td><i class="fas fa-cross text-primary me-2"></i>Saint Added</td>
                    <td>St. Teresa of Calcutta Biography</td>
                    <td><span class="status-badge status-approved">Published</span></td>
                    <td>Admin João</td>
                </tr>
                <tr>
                    <td>1 hour ago</td>
                    <td><i class="fas fa-language text-warning me-2"></i>Translation Updated</td>
                    <td>Portuguese - St. Padre Pio</td>
                    <td><span class="status-badge status-pending">In Review</span></td>
                    <td>Admin Carlos</td>
                </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Urgent Items Alert -->
    <div class="alert alert-custom" role="alert">
        <div class="d-flex align-items-center">
            <i class="fas fa-exclamation-circle me-3 fs-4"></i>
            <div>
                <strong>Action Required:</strong> 7 relic submissions are awaiting approval.
                <button class="btn btn-sm btn-outline-warning ms-2" data-content="relics">
                    Review Now
                </button>
            </div>
        </div>
    </div>
    </div>

    <!-- Relics Approval Content -->
    <div id="relics-content" style="display: none;">
        <div class="content-section">
            <div class="section-header">
                <h5 class="mb-0">
                    <i class="fas fa-gem me-2 text-warning"></i>
                    Relic Approval Queue
                </h5>
                <div>
                    <button class="btn btn-outline-primary btn-sm me-2">
                        <i class="fas fa-filter"></i>
                        Filter
                    </button>
                    <button class="btn btn-primary btn-sm">
                        <i class="fas fa-plus"></i>
                        Add Relic
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                    <tr>
                        <th>Relic</th>
                        <th>Saint</th>
                        <th>Type</th>
