                                     class="me-2" style="width: 32px; height: 32px;">
                                <span>Sacred Cloth Fragment</span>
                            </div>
                        </td>
                        <td>St. Francis of Assisi</td>
                        <td><span class="badge bg-primary">First-Class</span></td>
                        <td>Fr. Antonio Silva</td>
                        <td>2 days ago</td>
                        <td><span class="status-badge status-pending">Pending Review</span></td>
                        <td>
                            <button class="btn btn-sm btn-success me-1" data-bs-toggle="modal"
                                    data-bs-target="#approvalModal">
                                <i class="fas fa-check"></i>
                            </button>
                            <button class="btn btn-sm btn-warning me-1">
                                <i class="fas fa-eye"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger">
                                <i class="fas fa-times"></i>
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div class="d-flex align-items-center">
                                <img src="data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Crect width='40' height='40' rx='8' fill='%233b82f6'/%3E%3Cpath d='M12 18h16v4H12v-4z' fill='white'/%3E%3C/svg%3E"
                                     class="me-2" style="width: 32px; height: 32px;">
                                <span>Bone Fragment</span>
                            </div>
                        </td>
                        <td>St. Padre Pio</td>
                        <td><span class="badge bg-primary">First-Class</span></td>
                        <td>Diocese of Rome</td>
                        <td>3 days ago</td>
                        <td><span class="status-badge status-pending">Pending Review</span></td>
                        <td>
                            <button class="btn btn-sm btn-success me-1" data-bs-toggle="modal"
                                    data-bs-target="#approvalModal">
                                <i class="fas fa-check"></i>
                            </button>
                            <button class="btn btn-sm btn-warning me-1">
                                <i class="fas fa-eye"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger">
                                <i class="fas fa-times"></i>
                            </button>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Saints Management Content -->
    <div id="saints-content" style="display: none;">
        <div class="content-section">
            <div class="section-header">
                <h5 class="mb-0">
                    <i class="fas fa-cross me-2 text-primary"></i>
