                            <div class="d-flex align-items-center">
                                <img src="data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='20' cy='20' r='20' fill='%233b82f6'/%3E%3Cpath d='M20 8l2 6h6l-5 4 2 6-5-4-5 4 2-6-5-4h6l2-6z' fill='white'/%3E%3C/svg%3E"
