{% extends 'admin_base.html.twig' %}

{% block title %}Contact Messages - Admin{% endblock %}
{% block pageTitle %}Contact Messages{% endblock %}

{% block body %}
    {% if statistics %}
        <div class="dashboard-widgets">
            <div class="widget-card primary-accent">
                <div class="widget-number">{{ statistics.total }}</div>
                <div class="widget-label">Total Messages</div>
                <div class="widget-trend">
                    <i class="fas fa-envelope me-1"></i>
                    All time
                </div>
            </div>

            <div class="widget-card red-accent">
                <div class="widget-number">{{ statistics.new }}</div>
                <div class="widget-label">New Messages</div>
                <div class="widget-trend">
                    <i class="fas fa-bell me-1"></i>
                    Action required
                </div>
            </div>

            <div class="widget-card gold-accent">
                <div class="widget-number">{{ statistics.read }}</div>
                <div class="widget-label">Read Messages</div>
                <div class="widget-trend">
                    <i class="fas fa-envelope-open me-1"></i>
                    In progress
                </div>
            </div>

            <div class="widget-card success-accent">
                <div class="widget-number">{{ statistics.resolved }}</div>
                <div class="widget-label">Resolved Messages</div>
                <div class="widget-trend">
                    <i class="fas fa-check-circle me-1"></i>
                    Archived
                </div>
            </div>
        </div>
    {% endif %}

    <div class="content-section">
        <div class="section-header">
            <h5 class="mb-0">
                <i class="fas fa-filter me-2"></i>Filters
            </h5>
            <div class="filter-bar">
                <a href="{{ path('admin_contact_index') }}" class="btn btn-sm {{ currentStatus is null ? 'btn-primary' : 'btn-outline-primary' }}">All</a>
                <a href="{{ path('admin_contact_index', {status: 'new'}) }}" class="btn btn-sm {{ currentStatus == 'new' ? 'btn-primary' : 'btn-outline-primary' }}">New</a>
                <a href="{{ path('admin_contact_index', {status: 'read'}) }}" class="btn btn-sm {{ currentStatus == 'read' ? 'btn-primary' : 'btn-outline-primary' }}">Read</a>
                <a href="{{ path('admin_contact_index', {status: 'resolved'}) }}" class="btn btn-sm {{ currentStatus == 'resolved' ? 'btn-primary' : 'btn-outline-primary' }}">Resolved</a>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Subject</th>
                            <th>Message Preview</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for contact in pagination %}
                        <tr>
                            <td>
                                <span class="badge bg-{{ contact.status == 'new' ? 'primary' : (contact.status == 'read' ? 'info' : 'success') }}">
                                    {{ contact.status|upper }}
                                </span>
                            </td>
                            <td>{{ contact.createdAt|date('Y-m-d H:i') }}</td>
                            <td>{{ contact.name }}</td>
                            <td>
                                <a href="mailto:{{ contact.email }}">{{ contact.email }}</a>
                            </td>
                            <td>{{ contact.subject|replace({'_': ' '})|title }}</td>
                            <td class="text-muted small">{{ contact.message|length > 50 ? contact.message|slice(0, 50) ~ '...' : contact.message }}</td>
                            <td>
                                <a href="{{ path('admin_contact_show', {id: contact.id}) }}" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-eye"></i> View
                                </a>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="fas fa-envelope-open fa-2x mb-2"></i>
                                <p>No contact messages found.</p>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4 px-2">
                <div class="text-muted small">
                    {{ ((pagination.getCurrentPageNumber() - 1) * pagination.getItemNumberPerPage() + 1) }}-{{ min(pagination.getCurrentPageNumber() * pagination.getItemNumberPerPage(), pagination.getTotalItemCount) }} {{ 'common.pagination.of'|trans({}, 'common') }} {{ pagination.getTotalItemCount }} {{ 'common.pagination.items'|trans({}, 'common') }}
                </div>
                <div class="navigation">
                    {{ knp_pagination_render(pagination) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
