{% extends 'admin_base.html.twig' %}

{% block title %}{{ 'admin.saints.featured.title'|trans({}, 'admin') }}{% endblock %}
{% block pageTitle %}{{ 'admin.saints.featured.title'|trans({}, 'admin') }}{% endblock %}

{% block body %}
    <div class="content-section">
        <div class="card-body">
            {% if pagination.items is not empty %}
                <div class="mb-3">
                    <form method="post" action="{{ path('app_admin_saints_bulk_featured') }}" id="bulk-form">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="btn-group" role="group">
                                <button type="button" class="btn btn-outline-success" onclick="submitBulkAction('feature')">
                                    <i class="fas fa-star"></i> {{ 'admin.saints.featured.bulk_feature'|trans({}, 'admin') }}
                                </button>
                                <button type="button" class="btn btn-outline-secondary" onclick="submitBulkAction('unfeature')">
                                    <i class="fas fa-star-o"></i> {{ 'admin.saints.featured.bulk_unfeature'|trans({}, 'admin') }}
                                </button>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="select-all">
                                <label class="form-check-label" for="select-all">
                                    {{ 'admin.saints.featured.select_all'|trans({}, 'admin') }}
                                </label>
                            </div>
                        </div>
                        <input type="hidden" name="action" id="bulk-action">
                    </form>
                </div>
            {% endif %}

            {% if pagination.items is empty %}
                <div class="text-center py-4 text-muted">
                    <i class="fas fa-star fa-2x mb-2"></i>
                    <p>{{ 'admin.saints.featured.no_saints'|trans({}, 'admin') }}</p>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th scope="col" width="40">
                                    <input type="checkbox" id="select-all-header" class="form-check-input">
                                </th>
                                <th scope="col">ID</th>
                                <th scope="col">{{ 'saint.table.name'|trans({}, 'saint') }}</th>
                                <th scope="col">{{ 'admin.saints.featured.status'|trans({}, 'admin') }}</th>
                                <th scope="col">{{ 'saint.table.canonical_status'|trans({}, 'saint') }}</th>
                                <th scope="col">{{ 'saint.table.relics'|trans({}, 'saint') }}</th>
                                <th scope="col">{{ 'saint.table.actions'|trans({}, 'saint') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for saint in pagination %}
                            <tr>
                                <td>
                                    <input type="checkbox" name="saint_ids[]" value="{{ saint.id }}" class="form-check-input saint-checkbox" form="bulk-form">
                                </td>
                                <td>{{ saint.id }}</td>
                                <td>{{ saint.name }}</td>
                                <td>
                                    {% if saint.featured %}
                                        <span class="badge bg-success">
                                            <i class="fas fa-star"></i> {{ 'admin.saints.featured.featured'|trans({}, 'admin') }}
                                        </span>
                                    {% else %}
                                        <span class="badge bg-secondary">
                                            <i class="fas fa-star-o"></i> {{ 'admin.saints.featured.not_featured'|trans({}, 'admin') }}
                                        </span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if saint.canonicalStatus %}
                                        {{ saint.canonicalStatus.value }}
                                    {% else %}
                                        <span class="badge bg-warning text-dark">{{ 'admin.saints.incomplete.not_set'|trans({}, 'admin') }}</span>
                                    {% endif %}
                                </td>
                                <td>{{ saint.relics|length }}</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="{{ path('app_saint_edit', {'id': saint.id}) }}" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-pencil"></i> {{ 'saint.actions.edit'|trans({}, 'saint') }}
                                        </a>
                                        <form method="post" action="{{ path('app_admin_saints_toggle_featured', {'id': saint.id}) }}" style="display: inline;">
                                            {% if saint.featured %}
                                                <button type="submit" class="btn btn-sm btn-outline-secondary" onclick="return confirm('{{ 'admin.saints.featured.confirm_unfeature'|trans({}, 'admin') }}')">
                                                    <i class="fas fa-star-o"></i> {{ 'admin.saints.featured.unfeature'|trans({}, 'admin') }}
                                                </button>
                                            {% else %}
                                                <button type="submit" class="btn btn-sm btn-outline-success" onclick="return confirm('{{ 'admin.saints.featured.confirm_feature'|trans({}, 'admin') }}')">
                                                    <i class="fas fa-star"></i> {{ 'admin.saints.featured.feature'|trans({}, 'admin') }}
                                                </button>
                                            {% endif %}
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                
                <div class="d-flex justify-content-between align-items-center mt-4 px-2">
                    <div class="text-muted small">
                        {{ ((pagination.getCurrentPageNumber() - 1) * pagination.getItemNumberPerPage() + 1) }}-{{ min(pagination.getCurrentPageNumber() * pagination.getItemNumberPerPage(), pagination.getTotalItemCount) }} {{ 'common.pagination.of'|trans({}, 'common') }} {{ pagination.getTotalItemCount }} {{ 'common.pagination.items'|trans({}, 'common') }}
                    </div>
                    <div class="navigation">
                        {{ knp_pagination_render(pagination) }}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>

    <script>
        // Handle select all checkboxes
        document.getElementById('select-all').addEventListener('change', function() {
            const checkboxes = document.querySelectorAll('.saint-checkbox');
            checkboxes.forEach(checkbox => {
                checkbox.checked = this.checked;
            });
        });

        document.getElementById('select-all-header').addEventListener('change', function() {
            const checkboxes = document.querySelectorAll('.saint-checkbox');
            checkboxes.forEach(checkbox => {
                checkbox.checked = this.checked;
            });
        });

        // Submit bulk action
        function submitBulkAction(action) {
            const checkedBoxes = document.querySelectorAll('.saint-checkbox:checked');
            if (checkedBoxes.length === 0) {
                alert('{{ 'admin.saints.featured.no_selection'|trans({}, 'admin') }}');
                return;
            }
            
            const actionText = action === 'feature' ? '{{ 'admin.saints.featured.feature'|trans({}, 'admin') }}' : '{{ 'admin.saints.featured.unfeature'|trans({}, 'admin') }}';
            if (confirm('{{ 'admin.saints.featured.confirm_bulk'|trans({}, 'admin') }}'.replace('%action%', actionText).replace('%count%', checkedBoxes.length))) {
                document.getElementById('bulk-action').value = action;
                document.getElementById('bulk-form').submit();
            }
        }
    </script>
{% endblock %}