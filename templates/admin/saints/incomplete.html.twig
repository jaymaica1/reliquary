{% extends 'admin_base.html.twig' %}

{% block title %}{{ 'admin.saints.incomplete.title'|trans({}, 'admin') }}{% endblock %}
{% block pageTitle %}{{ 'admin.saints.incomplete.title'|trans({}, 'admin') }}{% endblock %}

{% block body %}
    <div class="content-section">
        <div class="card-body">
            {% if pagination.items is empty %}
                <div class="text-center py-4 text-muted">
                    <i class="fas fa-circle-check fa-2x mb-2"></i>
                    <p>{{ 'admin.saints.incomplete.no_saints'|trans({}, 'admin') }}</p>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th scope="col">ID</th>
                                <th scope="col">{{ 'saint.table.name'|trans({}, 'saint') }}</th>
                                <th scope="col">{{ 'saint.table.canonical_status'|trans({}, 'saint') }}</th>
                                <th scope="col">{{ 'saint.table.relics'|trans({}, 'saint') }}</th>
                                <th scope="col">{{ 'saint.table.actions'|trans({}, 'saint') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for saint in pagination %}
                            <tr>
                                <td>{{ saint.id }}</td>
                                <td>
                                    {% if '(Update)' in saint.name %}
                                        <span class="text-primary"><i class="fas fa-sync"></i> {{ saint.name }}</span>
                                    {% else %}
                                        {{ saint.name }}
                                    {% endif %}
                                </td>
                                <td>
                                    {% if saint.canonicalStatus %}
                                        {{ saint.canonicalStatus.value }}
                                    {% else %}
                                        <span class="badge bg-warning text-dark">{{ 'admin.saints.incomplete.not_set'|trans({}, 'admin') }}</span>
                                    {% endif %}
                                </td>
                                <td>{{ saint.relics|length }}</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="{{ path('app_saint_edit', {'id': saint.id, 'origin': 'incomplete'}) }}" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-pencil"></i> {{ 'saint.actions.edit'|trans({}, 'saint') }}
                                        </a>
                                        <form method="post" action="{{ path('app_admin_saints_mark_complete', {'id': saint.id}) }}" style="display:inline-block">
                                            <button class="btn btn-sm btn-outline-success">
                                                <i class="fas fa-circle-check"></i> {{ 'admin.saints.incomplete.mark_complete'|trans({}, 'admin') }}
                                            </button>
                                        </form>
                                        <form method="post" action="{{ path('app_admin_saints_discard', {'id': saint.id}) }}" style="display:inline-block" onsubmit="return confirm('{{ 'admin.saints.incomplete.confirm_discard'|trans({}, 'admin') }}');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('discard' ~ saint.id) }}">
                                            <button class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-trash"></i> {{ 'admin.saints.incomplete.discard'|trans({}, 'admin') }}
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                
                <div class="d-flex justify-content-between align-items-center mt-4 px-2">
                    <div class="text-muted small">
                        {{ ((pagination.getCurrentPageNumber() - 1) * pagination.getItemNumberPerPage() + 1) }}-{{ min(pagination.getCurrentPageNumber() * pagination.getItemNumberPerPage(), pagination.getTotalItemCount) }} {{ 'common.pagination.of'|trans({}, 'common') }} {{ pagination.getTotalItemCount }} {{ 'common.pagination.items'|trans({}, 'common') }}
                    </div>
                    <div class="navigation">
                        {{ knp_pagination_render(pagination) }}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}