<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ 'title'|trans({}, 'landing') }}{% endblock %}</title>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Lato:ital,wght@0,300;0,400;0,700;1,300;1,400&display=swap" rel="stylesheet">
    <link rel="preload" href="{{ asset('/images/relic.png') }}" as="image" type="image/png">
    <link rel="icon" href="{{ asset('/images/relic.png') }}">
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('landing') }}{% endblock %}
    {% endblock %}
</head>
<body data-controller="smooth-scroll fade-in">
    <div class="particles" id="particles" data-controller="particles"></div>
    
    <!-- Navigation -->
    <nav id="navbar" data-controller="navbar-scroll mobile-menu">
        <div class="nav-container">
            <a href="{{ path('app_home') }}" class="logo">{{ 'common.reliquary'|trans({}, 'common') }}</a>
            
            <!-- Mobile Menu Toggle -->
            <button class="mobile-menu-toggle" data-action="click->mobile-menu#toggle" data-mobile-menu-target="toggle">
                <span class="hamburger-line"></span>
                <span class="hamburger-line"></span>
                <span class="hamburger-line"></span>
            </button>
            
            <!-- Navigation Links -->
            <ul class="nav-links" data-mobile-menu-target="menu">
                <li><a href="{{ path('app_relic_index') }}">{{ 'nav.browse_relics'|trans({}, 'landing') }}</a></li>
                <li><a href="{{ path('app_saint_index') }}">{{ 'nav.saints'|trans({}, 'landing') }}</a></li>
                <li><a href="{{ path('app_about') }}">{{ 'nav.about'|trans({}, 'landing') }}</a></li>
                <li><a href="{{ path('app_contact') }}">{{ 'nav.contact'|trans({}, 'landing') }}</a></li>
                {% if app.user %}
                    <li class="dropdown-container">
                        <a href="#" class="dropdown-trigger" data-action="click->mobile-menu#toggleDropdown">
                            {% if app.user.profileImage %}
                                <img src="{{ image_url(app.user.profileImage.filename) }}"
                                     alt="{{ 'user.profile_image'|trans({}, 'user') }}" 
                                     class="user-avatar-mini">
                            {% else %}
                                <i class="fas fa-user-circle me-1"></i>
                            {% endif %}
                            {{ app.user.username }}
                            <i class="fas fa-chevron-down ms-1" style="font-size: 0.7rem;"></i>
                        </a>
                        <ul class="dropdown-content">
                            <li><a href="{{ path('app_relic_new') }}"><i class="fas fa-plus-circle me-2"></i>{{ 'nav.submit_relic'|trans({}, 'landing') }}</a></li>
                            <li><a href="{{ path('app_profile_show') }}"><i class="fas fa-user me-2"></i>{{ 'nav.profile'|trans({}, 'landing') }}</a></li>
                            {% if is_granted('ROLE_ADMIN') %}
                                <li><a href="{{ path('app_admin_dashboard') }}"><i class="fas fa-gauge-high me-2"></i>{{ 'nav.dashboard'|trans({}, 'landing') }}</a></li>
                            {% endif %}
                            <li class="dropdown-divider"></li>
                            <li><a href="{{ path('app_logout') }}"><i class="fas fa-sign-out-alt me-2"></i>{{ 'nav.logout'|trans({}, 'landing') }}</a></li>
                        </ul>
                    </li>
                {% else %}
                    <li><a href="{{ path('app_login') }}">{{ 'nav.login'|trans({}, 'landing') }}</a></li>
                {% endif %}
            </ul>
        </div>
    </nav>
    
    <!-- Additional Content Block -->
    {% block body %}{% endblock %}

    <!-- Call to Action Section - Only show if user is not logged in -->
    {% if not app.user %}
    <section class="cta-section">
        <div class="cta-content">
            <h2 class="cta-title">{{ 'cta.title'|trans({}, 'landing') }}</h2>
            <p class="cta-text">
                {{ 'cta.text'|trans({}, 'landing') }}
            </p>
            <div class="cta-buttons">
                <a href="{{ path('app_register') }}" class="btn btn-primary">{{ 'cta.create_account'|trans({}, 'landing') }}</a>
                <a href="{{ path('app_about') }}" class="btn btn-secondary">{{ 'cta.learn_more'|trans({}, 'landing') }}</a>
            </div>
        </div>
    </section>
    {% endif %}

    <!-- Footer -->
    <footer>
        <div class="footer-content">
            <div class="footer-links">
                <a href="{{ path('app_privacy_policy') }}">{{ 'footer.privacy'|trans({}, 'landing') }}</a>
                <a href="{{ path('app_terms_of_use') }}">{{ 'footer.terms'|trans({}, 'landing') }}</a>
                <a href="{{ path('app_about') }}#guidelines">{{ 'footer.guidelines'|trans({}, 'landing') }}</a>
                <a href="{{ path('app_about') }}#authentication">{{ 'footer.authentication'|trans({}, 'landing') }}</a>
                <a href="{{ path('app_contact') }}">{{ 'footer.support'|trans({}, 'landing') }}</a>
            </div>
            <div class="footer-divider"></div>
            <p class="footer-text">
                © {{ "now"|date("Y") }} {{ 'footer.copyright'|trans({}, 'landing') }}
            </p>
        </div>
    </footer>
</body>
</html>