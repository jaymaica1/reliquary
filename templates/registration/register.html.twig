{% extends 'landing_base.html.twig' %}

{% block title %}{{ 'registration.title'|trans({}, 'registration') }}{% endblock %}

{% block body %}
<section class="contact-section">
    <div class="contact-container">
        <h2 class="section-title">{{ 'registration.title'|trans({}, 'registration') }}</h2>
        
        <div class="contact-content contact-content-single">
            <div class="contact-form-section">
                <form class="contact-form" method="post">
                    {% if registrationForm.vars.errors|length > 0 %}
                        <div class="form-error-message">
                            {{ form_errors(registrationForm) }}
                        </div>
                    {% endif %}

                    {{ form_start(registrationForm, {'attr': {'novalidate': 'novalidate'}}) }}

                    <div class="form-group">
                        <label for="{{ registrationForm.username.vars.id }}">{{ 'registration.form.username'|trans({}, 'registration') }}</label>
                        {{ form_widget(registrationForm.username, {'attr': {'class': ''}}) }}
                        {{ form_errors(registrationForm.username) }}
                    </div>

                    <div class="form-group">
                        <label for="{{ registrationForm.email.vars.id }}">{{ 'registration.form.email'|trans({}, 'registration') }}</label>
                        {{ form_widget(registrationForm.email, {'attr': {'class': ''}}) }}
                        {{ form_errors(registrationForm.email) }}
                    </div>

                    <div class="form-group">
                        <label for="{{ registrationForm.plainPassword.vars.id }}">{{ 'registration.form.password'|trans({}, 'registration') }}</label>
                        <div class="password-toggle-wrapper" data-controller="password-toggle">
                            {{ form_widget(registrationForm.plainPassword, {'attr': {'class': '', 'data-password-toggle-target': 'input'}}) }}
                            <button type="button" data-action="password-toggle#toggle" class="password-toggle-btn">
                                <i class="fas fa-eye" data-password-toggle-target="icon"></i>
                            </button>
                        </div>
                        {{ form_errors(registrationForm.plainPassword) }}
                    </div>

                    <div class="form-group">
                        <label class="checkbox-label">
                            {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': ''}}) }}
                            {{ 'registration.form.agree_terms'|trans({}, 'registration') }}
                        </label>
                        {{ form_errors(registrationForm.agreeTerms) }}
                    </div>

                    <button type="submit" class="btn btn-primary">
                        {{ 'registration.form.submit'|trans({}, 'registration') }}
                    </button>

                    <div class="form-actions-center">
                        <p>
                            {{ 'registration.form.already_have_account'|trans({}, 'registration') }} 
                            <a href="{{ path('app_login') }}" class="gold-link">{{ 'registration.form.sign_in'|trans({}, 'registration') }}</a>
                        </p>
                    </div>

                    {{ form_end(registrationForm) }}
                </form>
            </div>
        </div>
    </div>
</section>
{% endblock %}
