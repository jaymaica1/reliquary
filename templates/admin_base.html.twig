<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ 'common.admin'|trans({}, 'common') }}{% endblock %}</title>  <link rel="preload" href="{{ asset('/images/relic.png') }}" as="image" type="image/png">
    <link rel="icon" href="{{ asset('/images/relic.png') }}">
    {% block stylesheets %}
    {% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('admin') }}{% endblock %}
    {% endblock %}
</head>
<body id="admin" data-controller="admin-base">
    {{ include('admin/_navbar.html.twig') }}
    <!-- Main Content -->
    <div class="main-content" id="mainContent" data-admin-base-target="mainContent">
        <!-- Top Navigation -->
        <header class="top-navbar">
            <div class="d-flex align-items-center">
                <button class="btn btn-link text-dark p-0 me-3" data-action="click->admin-base#toggleSidebar" data-admin-base-target="toggleButton">
                    <i class="fas fa-bars"></i>
                </button>
                <h5 class="mb-0" id="pageTitle">{% block pageTitle %}{{ 'common.admin.dashboard_overview'|trans({}, 'common') }}{% endblock %}</h5>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="position-relative">
                    <button class="btn btn-link text-dark position-relative">
                        <i class="fas fa-bell"></i>
                    </button>
                </div>
                <div class="dropdown">
                    <button class="btn btn-link text-dark dropdown-toggle" data-bs-toggle="dropdown">
                        {% if app.user and app.user.profileImage %}
                            <img src="{{ image_url(app.user.profileImage.filename) }}"
                                 alt="{{ app.user.username }}"
                                 class="rounded-circle me-2"
                                 style="width: 32px; height: 32px; object-fit: cover;">
                        {% else %}
                            <i class="fas fa-user-circle me-2"></i>
                        {% endif %}
                        {% if app.user %}
                            {{ app.user.username }}
                        {% else %}
                            {{ 'common.user.anonymous'|trans({}, 'common') }}
                        {% endif %}
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="{{ path('app_profile_show') }}"><i class="fas fa-user me-2"></i>{{ 'common.user.profile'|trans({}, 'common') }}</a></li>
                        <li><a class="dropdown-item" href="{{ path('app_my_relics') }}"><i class="fas fa-gem me-2"></i>{{ 'common.user.my_relics'|trans({}, 'common') }}</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="{{ path('app_home') }}"><i class="fas fa-home me-2"></i>{{ 'common.navigation.main_site'|trans({}, 'common') }}</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="{{ path('app_logout') }}"><i class="fas fa-sign-out-alt me-2"></i>{{ 'common.user.logout'|trans({}, 'common') }}</a></li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Content Area -->
        <div class="container-fluid p-4">
            <div id="dashboard-content">
                <!-- Flash Messages -->
                {% include '_flash_messages.html.twig' %}

                <!-- Main Content Block -->
                {% block body %}{% endblock %}
            </div>
        </div>
    </div>

    {% block footer_javascripts %}
    {% endblock %}
</body>
</html>