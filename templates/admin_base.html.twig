<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ 'common.admin'|trans({}, 'common') }}{% endblock %}</title>  <link rel="preload" href="{{ asset('/images/relic.png') }}" as="image" type="image/png">
    <link rel="icon" href="{{ asset('/images/relic.png') }}">
    {% block stylesheets %}
    {% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('admin') }}{% endblock %}
    {% endblock %}
</head>
<body id="admin" data-controller="admin-base">
    {{ include('admin/_navbar.html.twig') }}
    <!-- Main Content -->
    <div class="main-content" id="mainContent" data-admin-base-target="mainContent">
        <!-- Top Navigation -->
        <header class="top-navbar">
            <div class="d-flex align-items-center">
                <button class="btn btn-link text-dark p-0 me-3" data-action="click->admin-base#toggleSidebar" data-admin-base-target="toggleButton">
                    <i class="fas fa-bars"></i>
                </button>
                <h5 class="mb-0" id="pageTitle">{% block pageTitle %}{{ 'common.admin.dashboard_overview'|trans({}, 'common') }}{% endblock %}</h5>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="position-relative dropdown">
                    <button class="btn btn-link text-dark position-relative dropdown-toggle" 
                            data-bs-toggle="dropdown" 
                            data-bs-auto-close="outside"
                            aria-expanded="false"
                            id="notificationDropdown">
                        <i class="fas fa-bell"></i>
                        {% if notifications is defined and (notifications.incompleteSaints > 0 or notifications.pendingRelics > 0 or notifications.errorLogs > 0) %}
                            <div class="notification-dot"></div>
                        {% endif %}
                    </button>
                    <div class="dropdown-menu dropdown-menu-end notification-dropdown" aria-labelledby="notificationDropdown">
                        <div class="dropdown-header d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">{{ 'common.admin.notifications'|trans({}, 'common') }}</h6>
                            {% set totalNotifications = 0 %}
                            {% if notifications is defined %}
                                {% set totalNotifications = notifications.incompleteSaints + notifications.pendingRelics + notifications.errorLogs %}
                            {% endif %}
                            <span class="badge bg-primary rounded-pill">{{ totalNotifications }}</span>
                        </div>
                        <div class="dropdown-divider"></div>
                        
                        {% if notifications is defined and totalNotifications > 0 %}
                            {% if notifications.incompleteSaints > 0 %}
                                <a class="dropdown-item notification-item" href="{{ path('app_admin_saints_incomplete') }}">
                                    <div class="d-flex align-items-center">
                                        <div class="notification-icon bg-warning text-white rounded-circle me-3">
                                            <i class="fas fa-cross"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="notification-title">{{ 'common.admin.incomplete_saints'|trans({}, 'common') }}</div>
                                            <div class="notification-desc text-muted">{{ notifications.incompleteSaints }} {{ 'common.admin.incomplete_saints_count'|trans({}, 'common') }}</div>
                                        </div>
                                    </div>
                                </a>
                            {% endif %}
                            
                            {% if notifications.pendingRelics > 0 %}
                                <a class="dropdown-item notification-item" href="{{ path('app_pending_relics') }}">
                                    <div class="d-flex align-items-center">
                                        <div class="notification-icon bg-info text-white rounded-circle me-3">
                                            <i class="fas fa-gem"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="notification-title">{{ 'common.admin.pending_relics'|trans({}, 'common') }}</div>
                                            <div class="notification-desc text-muted">{{ notifications.pendingRelics }} {{ 'common.admin.pending_relics_count'|trans({}, 'common') }}</div>
                                        </div>
                                    </div>
                                </a>
                            {% endif %}
                            
                            {% if notifications.errorLogs > 0 %}
                                <a class="dropdown-item notification-item" href="{{ path('app_admin_logs') }}">
                                    <div class="d-flex align-items-center">
                                        <div class="notification-icon bg-danger text-white rounded-circle me-3">
                                            <i class="fas fa-exclamation-triangle"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="notification-title">{{ 'common.admin.system_logs'|trans({}, 'common') }}</div>
                                            <div class="notification-desc text-muted">{{ notifications.errorLogs }} {{ 'common.admin.error_logs_count'|trans({}, 'common') }}</div>
                                        </div>
                                    </div>
                                </a>
                            {% endif %}
                        {% else %}
                            <div class="dropdown-item-text text-center text-muted py-4">
                                <i class="fas fa-check-circle mb-2" style="font-size: 2rem; opacity: 0.5;"></i>
                                <div>{{ 'common.admin.no_notifications'|trans({}, 'common') }}</div>
                            </div>
                        {% endif %}
                        
                        <div class="dropdown-divider"></div>
                        <div class="dropdown-footer text-center">
                            <a href="{{ path('app_admin_dashboard') }}" class="btn btn-sm btn-outline-primary">
                                {{ 'common.admin.view_dashboard'|trans({}, 'common') }}
                            </a>
                        </div>
                    </div>
                </div>
                <div class="dropdown">
                    <button class="btn btn-link text-dark dropdown-toggle" data-bs-toggle="dropdown">
                        {% if app.user and app.user.profileImage %}
                            <img src="{{ image_url(app.user.profileImage.filename) }}"
                                 alt="{{ app.user.username }}"
                                 class="rounded-circle me-2"
                                 style="width: 32px; height: 32px; object-fit: cover;">
                        {% else %}
                            <i class="fas fa-user-circle me-2"></i>
                        {% endif %}
                        {% if app.user %}
                            {{ app.user.username }}
                        {% else %}
                            {{ 'common.user.anonymous'|trans({}, 'common') }}
                        {% endif %}
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="{{ path('app_profile_show') }}"><i class="fas fa-user me-2"></i>{{ 'common.user.profile'|trans({}, 'common') }}</a></li>
                        <li><a class="dropdown-item" href="{{ path('app_my_relics') }}"><i class="fas fa-gem me-2"></i>{{ 'common.user.my_relics'|trans({}, 'common') }}</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="{{ path('app_home') }}"><i class="fas fa-home me-2"></i>{{ 'common.navigation.main_site'|trans({}, 'common') }}</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="{{ path('app_logout') }}"><i class="fas fa-sign-out-alt me-2"></i>{{ 'common.user.logout'|trans({}, 'common') }}</a></li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- Content Area -->
        <div class="container-fluid p-4">
            <div id="dashboard-content">
                <!-- Flash Messages -->
                {% include '_flash_messages.html.twig' %}

                <!-- Main Content Block -->
                {% block body %}{% endblock %}
            </div>
        </div>
    </div>

    {% block footer_javascripts %}
    {% endblock %}
</body>
</html>