<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ 'common.admin'|trans({}, 'common') }}{% endblock %}</title>
    <meta name="robots" content="noindex, nofollow">
    <!-- Favicons -->
    <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('images/favicon/apple-touch-icon.png') }}">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('images/favicon/favicon-32x32.png') }}">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ asset('images/favicon/favicon-16x16.png') }}">
    <link rel="shortcut icon" href="{{ asset('images/favicon/favicon.ico') }}">
    <link rel="manifest" href="{{ asset('site.webmanifest') }}">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#ffffff">

    <link rel="preload" href="{{ asset('/images/relic.png') }}" as="image" type="image/png">
    {% block stylesheets %}
    {% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('admin') }}{% endblock %}
    {% endblock %}
</head>
<body id="admin" data-controller="admin-base cookie-consent">
    {{ include('admin/_navbar.html.twig') }}
    <!-- Main Content -->
    <div class="main-content" id="mainContent" data-admin-base-target="mainContent">
        <!-- Top Navigation -->
        <header class="top-navbar">
            <div class="d-flex align-items-center">
                <button class="btn btn-link text-dark p-0 me-3" data-action="click->admin-base#toggleSidebar" data-admin-base-target="toggleButton">
                    <i class="fas fa-bars"></i>
                </button>
                <h5 class="mb-0" id="pageTitle">{% block pageTitle %}{{ 'common.admin.dashboard_overview'|trans({}, 'common') }}{% endblock %}</h5>
            </div>
            <div class="d-flex align-items-center gap-3">
                {{  include('admin/_notification.html.twig') }}
                {{  include('admin/_user_menu.html.twig') }}
            </div>
        </header>

        <!-- Content Area -->
        <div class="container-fluid p-4">
            <div id="dashboard-content">
                <!-- Flash Messages -->
                {% include '_flash_messages.html.twig' %}

                <!-- Main Content Block -->
                {% block body %}{% endblock %}
            </div>

            <!-- Admin Footer -->
            <footer class="mt-5 pt-3 border-top text-muted small">
                <div class="d-flex justify-content-between">
                    <div>
                        &copy; {{ "now"|date("Y") }} {{ 'common.reliquary'|trans({}, 'common') }}
                    </div>
                    <div>
                        <a href="#" class="text-muted text-decoration-none" data-action="click->cookie-consent#showBanner">
                            <i class="fas fa-cookie-bite me-1"></i>
                            {{ 'common.cookie_consent.settings'|trans({}, 'common') }}
                        </a>
                        <span class="mx-2">|</span>
                        Reliquary v{{ app_version }}
                    </div>
                </div>
            </footer>
        </div>
    </div>

    {% block footer_javascripts %}
    {% endblock %}
    {% include '_cookie_banner.html.twig' %}
</body>
</html>